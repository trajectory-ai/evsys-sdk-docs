l_loader","tags":[],"type":"text","url":"/docs/evsys_sdk/yaml_loader","content":"Step 2 happens lazily inside the runner (on actual use) so unknown extensions\ndiscovered via entry points don't fail validation prematurely. But you can\ncall `validate_yaml(path, *, deep=True)` to force step 2 up front."},"2011":{"id":"/docs/evsys_sdk/yaml_loader-6","page_id":"/docs/evsys_sdk/yaml_loader","tags":[],"type":"text","url":"/docs/evsys_sdk/yaml_loader","content":"Parse and validate a YAML experiment file."},"2012":{"id":"/docs/evsys_sdk/yaml_loader-7","page_id":"/docs/evsys_sdk/yaml_loader","tags":[],"type":"text","url":"/docs/evsys_sdk/yaml_loader","content":"Serialize an ExperimentConfig back to YAML."},"2013":{"id":"/docs/evsys_sdk/yaml_loader-8","page_id":"/docs/evsys_sdk/yaml_loader","tags":[],"type":"text","url":"/docs/evsys_sdk/yaml_loader","content":"Return a list of validation errors. Empty list = valid."},"2014":{"id":"/docs/evsys_sdk/yaml_loader-9","page_id":"/docs/evsys_sdk/yaml_loader","tags":[],"type":"text","url":"/docs/evsys_sdk/yaml_loader","content":"If `deep` is True, also validate every kind/params block against its\nregistered .Config model."},"2015":{"id":"/docs/evsys_sdk/yaml_loader-10","page_id":"/docs/evsys_sdk/yaml_loader","tags":[],"type":"text","url":"/docs/evsys_sdk/yaml_loader","content":"Replace `cfg.matrix` with `cfg.runs`, preserving everything else."},"2016":{"id":"/docs/evsys_sdk/backends/mock/MockBackend","page_id":"/docs/evsys_sdk/backends/mock/MockBackend","type":"page","content":"MockBackend","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","backends","mock"],"tags":[],"url":"/docs/evsys_sdk/backends/mock/MockBackend"},"2017":{"id":"/docs/evsys_sdk/backends/mock/MockBackend-0","page_id":"/docs/evsys_sdk/backends/mock/MockBackend","type":"heading","tags":[],"url":"/docs/evsys_sdk/backends/mock/MockBackend#attributes","content":"Attributes"},"2018":{"id":"/docs/evsys_sdk/backends/mock/MockBackend-1","page_id":"/docs/evsys_sd