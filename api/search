_sdk/config/DataConfig","tags":[],"type":"text","url":"/docs/evsys_sdk/config/DataConfig#attributes","content":"For 'jsonl' / 'json': absolute or store-relative path."},"1686":{"id":"/docs/evsys_sdk/config/DataConfig-7","page_id":"/docs/evsys_sdk/config/DataConfig","tags":[],"type":"text","url":"/docs/evsys_sdk/config/DataConfig#attributes","content":"For 'in\\_memory'."},"1687":{"id":"/docs/evsys_sdk/config/DataConfig-8","page_id":"/docs/evsys_sdk/config/DataConfig","tags":[],"type":"text","url":"/docs/evsys_sdk/config/DataConfig#attributes","content":"For 'hf\\_dataset': HuggingFace dataset id."},"1688":{"id":"/docs/evsys_sdk/config/DataConfig-9","page_id":"/docs/evsys_sdk/config/DataConfig","tags":[],"type":"text","url":"/docs/evsys_sdk/config/DataConfig#attributes","content":"Applied in order to the raw rows."},"1689":{"id":"/docs/evsys_sdk/config/DataStoreSpec","page_id":"/docs/evsys_sdk/config/DataStoreSpec","type":"page","content":"DataStoreSpec","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","config"],"tags":[],"url":"/docs/evsys_sdk/config/DataStoreSpec"},"1690":{"id":"/docs/evsys_sdk/config/DataStoreSpec-0","page_id":"/docs/evsys_sdk/config/DataStoreSpec","type":"heading","tags":[],"url":"/docs/evsys_sdk/config/DataStoreSpec#attributes","content":"Attributes"},"1691":{"id":"/docs/evsys_sdk/config/DataStoreSpec-1","page_id":"/docs/evsys_sdk/config/DataStoreSpec","tags":[],"type":"text","url":"/docs/evsys_sdk/config/DataStoreSpec#attributes","content":"e.g. 'local', 'supabase', 'in\\_memory'."},"1692":{"id":"/docs/evsys_sdk/config/ExperimentConfig","page_id":"/docs/evsys_sdk/config/ExperimentConfig","type":"page","content":"ExperimentConfig","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","config"],"tags":[],"url":"/docs/evsys_sdk/config/ExperimentConfig"},"1693":{"id":"/docs/evsys_sdk/config/ExperimentConfig-0","page_id":"/docs/evsys_sdk/config/ExperimentConfig","type":"heading","tags":[],"url":"/docs/evsys_sdk/config/ExperimentCo