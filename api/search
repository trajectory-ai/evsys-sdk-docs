id":"/docs/evsys_sdk/workspace","tags":[],"type":"text","url":"/docs/evsys_sdk/workspace","content":"<Card title=\"&#x22;MaterializedDataset&#x22;\" href=\"&#x22;/docs/evsys_sdk/workspace/MaterializedDataset&#x22;\" />"},"1979":{"id":"/docs/evsys_sdk/workspace-5","page_id":"/docs/evsys_sdk/workspace","tags":[],"type":"text","url":"/docs/evsys_sdk/workspace","content":"<Card title=\"&#x22;Workspace&#x22;\" href=\"&#x22;/docs/evsys_sdk/workspace/Workspace&#x22;\" />"},"1980":{"id":"/docs/evsys_sdk/workspace-6","page_id":"/docs/evsys_sdk/workspace","tags":[],"type":"text","url":"/docs/evsys_sdk/workspace","content":"Read a materialized `.evsys/` JSONL (one payload per line) to dicts."},"1981":{"id":"/docs/evsys_sdk/training","page_id":"/docs/evsys_sdk/training","type":"page","content":"training","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training"],"tags":[],"url":"/docs/evsys_sdk/training"},"1982":{"id":"/docs/evsys_sdk/training-0","page_id":"/docs/evsys_sdk/training","tags":[],"type":"text","url":"/docs/evsys_sdk/training","content":"evsys\\_sdk.training — native training-loop package."},"1983":{"id":"/docs/evsys_sdk/training-1","page_id":"/docs/evsys_sdk/training","tags":[],"type":"text","url":"/docs/evsys_sdk/training","content":"Three concerns, three modules:"},"1984":{"id":"/docs/evsys_sdk/training-2","page_id":"/docs/evsys_sdk/training","tags":[],"type":"text","url":"/docs/evsys_sdk/training","content":":mod:`~evsys_sdk.training.backend` — `Backend` Protocol, `SamplingClient`\nProtocol, in-memory `MockBackend` for tests. The only seam that talks to\ntinker (or a stand-in)."},"1985":{"id":"/docs/evsys_sdk/training-3","page_id":"/docs/evsys_sdk/training","tags":[],"type":"text","url":"/docs/evsys_sdk/training","content":":mod:`~evsys_sdk.training.loop` — `TrainingLoop` driver, `StepBuilder`\nProtocol, `TrainingBatch` dataclass, `Evaluator` Protocol, `LoopArtifacts`."},"1986":{"id":"/docs/evsys_sdk/training-4","page_id":"/docs/evsys_sdk/training"