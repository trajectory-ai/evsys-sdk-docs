sdk/runner","tags":[],"type":"text","url":"/docs/evsys_sdk/runner","content":"backend.teardown(handles)."},"1884":{"id":"/docs/evsys_sdk/runner-9","page_id":"/docs/evsys_sdk/runner","tags":[],"type":"text","url":"/docs/evsys_sdk/runner","content":"Run eval if enabled. (Eval is best-effort; a failure here doesn't kill the run.)"},"1885":{"id":"/docs/evsys_sdk/runner-10","page_id":"/docs/evsys_sdk/runner","tags":[],"type":"text","url":"/docs/evsys_sdk/runner","content":"Persist run\\_result.json."},"1886":{"id":"/docs/evsys_sdk/runner-11","page_id":"/docs/evsys_sdk/runner","tags":[],"type":"text","url":"/docs/evsys_sdk/runner","content":"Returns a list\\[RunResult] (one per run in the experiment)."},"1887":{"id":"/docs/evsys_sdk/runner-12","page_id":"/docs/evsys_sdk/runner","tags":[],"type":"text","url":"/docs/evsys_sdk/runner","content":"Run an experiment from a parsed config or YAML file."},"1888":{"id":"/docs/evsys_sdk/runner-13","page_id":"/docs/evsys_sdk/runner","tags":[],"type":"text","url":"/docs/evsys_sdk/runner","content":"`extra_context` is merged into each run's `RunContext.extras` — used by\n`Experiment` to pass the dashboard `store` + `dashboard_run_id` so\nin-loop validation can upload its rollouts."},"1889":{"id":"/docs/evsys_sdk/step_metrics","page_id":"/docs/evsys_sdk/step_metrics","type":"page","content":"step_metrics","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","step_metrics"],"tags":[],"url":"/docs/evsys_sdk/step_metrics"},"1890":{"id":"/docs/evsys_sdk/step_metrics-0","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"Forward per-step metrics from a local JSONL log to a EvsysStore."},"1891":{"id":"/docs/evsys_sdk/step_metrics-1","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"Two row shapes are accepted:"},"1892":{"id":"/docs/evsys_sdk/step_metrics-2","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"**Nested** (the SDK's own `log_store` output)::"},"1893":{"id":"/docs/evsys_sdk/step_metrics-3","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"\\{\"ts\": 1700000000.0, \"step\": 50, \"metrics\": \\{\"loss\": 0.42, \"lr\": 1e-4}}"},"1894":{"id":"/docs/evsys_sdk/step_metrics-4","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"**Flat** (`tinker_cookbook`'s native `metrics.jsonl`)::"},"1895":{"id":"/docs/evsys_sdk/step_metrics-5","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"\\{\"step\": 50, \"epoch\": 0, \"train\\_mean\\_nll\": 0.42, \"learning\\_rate\": 1e-4,\n\"time/get\\_batch\": 3e-06, \"time/step\": 18.1, ...}"},"1896":{"id":"/docs/evsys_sdk/step_metrics-6","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"The forwarder normalizes both into a `dict[str, float]` via\n:func:`_extract_metrics` before pushing."},"1897":{"id":"/docs/evsys_sdk/step_metrics-7","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"Until now researcher scripts have hand-rolled a forwarder loop after each\ntraining run (see `composio-bench/training/backfill_step_metrics.py`).\nThis module gives them one call:"},"1898":{"id":"/docs/evsys_sdk/step_metrics-8","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"forward\\_step\\_metrics(store, run\\_id, run\\_dir)"},"1899":{"id":"/docs/evsys_sdk/step_metrics-9","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"It locates `metrics.jsonl` under `run_dir` (preferring `run_dir/logs/`),\nwalks each row, and calls `store.log_metrics(run_id=..., step=..., metrics=\\{...\\})`.\nPer-row store errors are swallowed (logged), so a flaky upload doesn't drop\nthe rest of the metrics."},"1900":{"id":"/docs/evsys_sdk/step_metrics-10","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"Called automatically by `Experiment._train_arm` after each arm — researcher\nscripts using the OOP path don't have to think about it."},"1901":{"id":"/docs/evsys_sdk/step_metrics-11","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"Return the metrics dict from a row, normalizing nested + flat shapes."},"1902":{"id":"/docs/evsys_sdk/step_metrics-12","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"Nested rows carry the dict under `\"metrics\"`. Flat rows\n(`tinker_cookbook`) have each metric at the top level alongside `step`;\nwe collect every non-meta numeric value and coerce to float. Returns\n`None` when no usable metrics can be extracted."},"1903":{"id":"/docs/evsys_sdk/step_metrics-13","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"Push every row of a `metrics.jsonl` to the store. Returns row count."},"1904":{"id":"/docs/evsys_sdk/step_metrics-14","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"Returns `0` (silent no-op) if `store` is None, `run_id` is None,\n`run_dir` is missing, or the metrics file isn't found. Malformed JSON\nrows and rows missing `step`/`metrics` are skipped; per-row store\nexceptions are caught so one bad upload doesn't drop the rest."},"1905":{"id":"/docs/evsys_sdk/step_metrics-15","page_id":"/docs/evsys_sdk/step_metrics","tags":[],"type":"text","url":"/docs/evsys_sdk/step_metrics","content":"Find `metrics.jsonl` under `run_dir`. Prefer `\\<run_dir>/logs/`."},"1906":{"id":"/docs/evsys_sdk/registry/Registry","page_id":"/docs/evsys_sdk/registry/Registry","type":"page","content":"Registry","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","registry"],"tags":[],"url":"/docs/evsys_sdk/registry/Registry"},"1907":{"id":"/docs/evsys_sdk/registry/Registry-0","page_id":"/docs/evsys_sdk/registry/Registry","type":"heading","tags":[],"url":"/docs/evsys_sdk/registry/Registry#functions","content":"Functions"},"1908":{"id":"/docs/evsys_sdk/registry/Registry-1","page_id":"/docs/evsys_sdk/registry/Registry","tags":[],"type":"text","url":"/docs/evsys_sdk/registry/Registry","content":"Generic name->class registry."},"1909":{"id":"/docs/evsys_sdk/registry/Registry-2","page_id":"/docs/evsys_sdk/registry/Registry","tags":[],"type":"text","url":"/docs/evsys_sdk/registry/Registry#functions","content":"Remove an entry. Mostly for tests."},"1910":{"id":"/docs/evsys_sdk/registry","page_id":"/docs/evsys_sdk/registry","type":"page","content":"registry","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","registry"],"tags":[],"url":"/docs/evsys_sdk/registry"},"1911":{"id":"/docs/evsys_sdk/registry-0","page_id":"/docs/evsys_sdk/registry","tags":[],"type":"text","url":"/docs/evsys_sdk/registry","content":"Registries — one per extension point."},"1912":{"id":"/docs/evsys_sdk/registry-1","page_id":"/docs/evsys_sdk/registry","tags":[],"type":"text","url":"/docs/evsys_sdk/registry","content":"Each registry is a tiny namespace with:"},"1913":{"id":"/docs/evsys_sdk/registry-2","page_id":"/docs/evsys_sdk/registry","tags":[],"type":"text","url":"/docs/evsys_sdk/registry","content":"`register_\\<thing>(name)` decorator."},"1914":{"id":"/docs/evsys_sdk/registry-3","page_id":"/docs/evsys_sdk/registry","tags":[],"type":"text","url":"/docs/evsys_sdk/registry","content":"`get_\\<thing>(name)` lookup."},"1915":{"id":"/docs/evsys_sdk/registry-4","page_id":"/docs/evsys_sdk/registry","tags":[],"type":"text","url":"/docs/evsys_sdk/registry","content":"`list_\\<thing>s()` enumeration."},"1916":{"id":"/docs/evsys_sdk/registry-5","page_id":"/docs/evsys_sdk/registry","tags":[],"type":"text","url":"/docs/evsys_sdk/registry","content":"Adding a new algorithm/verifier/metric is one decorator + a Pydantic Config\nclass. No subclassing the library, no editing any list."},"1917":{"id":"/docs/evsys_sdk/registry-6","page_id":"/docs/evsys_sdk/registry","tags":[],"type":"text","url":"/docs/evsys_sdk/registry","content":"Third-party packages can also register via Python entry points; see\n`_entry_points.py` for the loader."},"1918":{"id":"/docs/evsys_sdk/registry-7","page_id":"/docs/evsys_sdk/registry","tags":[],"type":"text","url":"/docs/evsys_sdk/registry","content":"<Card title=\"&#x22;Registry&#x22;\" href=\"&#x22;/docs/evsys_sdk/registry/Registry&#x22;\" />"},"1919":{"id":"/docs/evsys_sdk/registry-8","page_id":"/docs/evsys_sdk/registry","tags":[],"type":"text","url":"/docs/evsys_sdk/registry","content":"Register the default `(run_result, run_cfg) -> InferenceClient` for\na backend kind. Called by each inference module's import side-effect\n(e.g. `inference/tinker.py` registers `\"tinker\"`)."},"1920":{"id":"/docs/evsys_sdk/registry-9","page_id":"/docs/evsys_sdk/registry","tags":[],"type":"text","url":"/docs/evsys_sdk/registry","content":"Return the registered default factory for `backend_kind` or `None`."},"1921":{"id":"/docs/evsys_sdk/registry-10","page_id":"/docs/evsys_sdk/registry","tags":[],"type":"text","url":"/docs/evsys_sdk/registry","content":"Return the JSON schema for a registered extension's Config."},"1922":{"id":"/docs/evsys_sdk/registry-11","page_id":"/docs/evsys_sdk/registry","tags":[],"type":"text","url":"/docs/evsys_sdk/registry","content":"Used by evolutionary algorithms to know the legal field space."},"1923":{"id":"/docs/evsys_sdk/sweep/Sweep","page_id":"/docs/evsys_sdk/sweep/Sweep","type":"page","content":"Sweep","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","sweep"],"tags":[],"url":"/docs/evsys_sdk/sweep/Sweep"},"1924":{"id":"/docs/evsys_sdk/sweep/Sweep-0","page_id":"/docs/evsys_sdk/sweep/Sweep","type":"heading","tags":[],"url":"/docs/evsys_sdk/sweep/Sweep#attributes","content":"Attributes"},"1925":{"id":"/docs/evsys_sdk/sweep/Sweep-1","page_id":"/docs/evsys_sdk/sweep/Sweep","type":"heading","tags":[],"url":"/docs/evsys_sdk/sweep/Sweep#functions","content":"Functions"},"1926":{"id":"/docs/evsys_sdk/sweep/Sweep-2","page_id":"/docs/evsys_sdk/sweep/Sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep/Sweep","content":"Declarative axes over a single `RunConfig`."},"1927":{"id":"/docs/evsys_sdk/sweep/Sweep-3","page_id":"/docs/evsys_sdk/sweep/Sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep/Sweep#functions","content":"Cartesian product over axes → one `RunConfig` per cell."},"1928":{"id":"/docs/evsys_sdk/sweep/Sweep-4","page_id":"/docs/evsys_sdk/sweep/Sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep/Sweep#functions","content":"Repackage as a `MatrixSpec` for YAML serialization."},"1929":{"id":"/docs/evsys_sdk/sweep","page_id":"/docs/evsys_sdk/sweep","type":"page","content":"sweep","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","sweep"],"tags":[],"url":"/docs/evsys_sdk/sweep"},"1930":{"id":"/docs/evsys_sdk/sweep-0","page_id":"/docs/evsys_sdk/sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep","content":"Sweep — declarative axes over a single `RunConfig`."},"1931":{"id":"/docs/evsys_sdk/sweep-1","page_id":"/docs/evsys_sdk/sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep","content":"A `Sweep` is the OOP way to describe what YAML's `matrix:` block describes:\none `base_run` template + per-axis lists of values, expanded by cartesian\nproduct into N concrete `RunConfig` rows."},"1932":{"id":"/docs/evsys_sdk/sweep-2","page_id":"/docs/evsys_sdk/sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep","content":"This is what an experiment script reaches for instead of writing a per-axis\n`for` loop. Sweep + Experiment together let `run.py` stay declarative:"},"1933":{"id":"/docs/evsys_sdk/sweep-3","page_id":"/docs/evsys_sdk/sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep","content":"sweep = Sweep(base\\_run, \\{\"algorithm.params.lora\\_rank\": \\[1, 4, 16]})\nfor run in sweep.expand():\n..."},"1934":{"id":"/docs/evsys_sdk/sweep-4","page_id":"/docs/evsys_sdk/sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep","content":"Or, more commonly, from a YAML matrix block already parsed into\n`MatrixSpec` — round-trip with `Sweep.from_matrix` / `.to_matrix`."},"1935":{"id":"/docs/evsys_sdk/sweep-5","page_id":"/docs/evsys_sdk/sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep","content":"The expansion is the single source of truth for both the YAML `matrix:`\nloader and programmatic builds (the legacy `_expand_matrix` delegates here)."},"1936":{"id":"/docs/evsys_sdk/sweep-6","page_id":"/docs/evsys_sdk/sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep","content":"<Card title=\"&#x22;Sweep&#x22;\" href=\"&#x22;/docs/evsys_sdk/sweep/Sweep&#x22;\" />"},"1937":{"id":"/docs/evsys_sdk/sweep-7","page_id":"/docs/evsys_sdk/sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep","content":"Cartesian product of `axes` over `base_run`."},"1938":{"id":"/docs/evsys_sdk/sweep-8","page_id":"/docs/evsys_sdk/sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep","content":"Single source of truth for matrix expansion — both `Sweep.expand` and\nthe YAML loader's `_expand_matrix` route through here. Empty `axes`\nreturns `[base_run]` unchanged."},"1939":{"id":"/docs/evsys_sdk/sweep-9","page_id":"/docs/evsys_sdk/sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep","content":"Substitute `\\{dotted.key\\}` placeholders without going through str.format."},"1940":{"id":"/docs/evsys_sdk/sweep-10","page_id":"/docs/evsys_sdk/sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep","content":"`str.format` treats dots as attribute access; we just want literal\ndotted keys."},"1941":{"id":"/docs/evsys_sdk/sweep-11","page_id":"/docs/evsys_sdk/sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep","content":"Walk a dotted path into a nested-dict tree and set the leaf value."},"1942":{"id":"/docs/evsys_sdk/sweep-12","page_id":"/docs/evsys_sdk/sweep","tags":[],"type":"text","url":"/docs/evsys_sdk/sweep","content":"Always called on a `RunConfig.model_dump()` result, so every node is a\ndict; intermediate keys missing on params-style dicts are auto-created\n(with `setdefault`), and a typo in a strict path is caught later by\n`RunConfig.model_validate`."},"1943":{"id":"/docs/evsys_sdk/store/EvsysStore","page_id":"/docs/evsys_sdk/store/EvsysStore","type":"page","content":"EvsysStore","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","store"],"tags":[],"url":"/docs/evsys_sdk/store/EvsysStore"},"1944":{"id":"/docs/evsys_sdk/store/EvsysStore-0","page_id":"/docs/evsys_sdk/store/EvsysStore","type":"heading","tags":[],"url":"/docs/evsys_sdk/store/EvsysStore#attributes","content":"Attributes"},"1945":{"id":"/docs/evsys_sdk/store/EvsysStore-1","page_id":"/docs/evsys_sdk/store/EvsysStore","type":"heading","tags":[],"url":"/docs/evsys_sdk/store/EvsysStore#functions","content":"Functions"},"1946":{"id":"/docs/evsys_sdk/store/EvsysStoreError","page_id":"/docs/evsys_sdk/store/EvsysStoreError","type":"page","content":"EvsysStoreError","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","store"],"tags":[],"url":"/docs/evsys_sdk/store/EvsysStoreError"},"1947":{"id":"/docs/evsys_sdk/store/EvsysStoreError-0","page_id":"/docs/evsys_sdk/store/EvsysStoreError","type":"heading","tags":[],"url":"/docs/evsys_sdk/store/EvsysStoreError#functions","content":"Functions"},"1948":{"id":"/docs/evsys_sdk/store","page_id":"/docs/evsys_sdk/store","type":"page","content":"store","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","store"],"tags":[],"url":"/docs/evsys_sdk/store"},"1949":{"id":"/docs/evsys_sdk/store-0","page_id":"/docs/evsys_sdk/store","tags":[],"type":"text","url":"/docs/evsys_sdk/store","content":"EvsysStore — HTTP client for the project → goals/datasets/benchmarks →\nexperiments → groups → runs → checkpoints/evals/metrics hierarchy."},"1950":{"id":"/docs/evsys_sdk/store-1","page_id":"/docs/evsys_sdk/store","tags":[],"type":"text","url":"/docs/evsys_sdk/store","content":"The SDK holds **no Supabase service key**. Every call routes through the\nbackend gateway (`POST \\{API\\}/api/dashboard/api/sdk/data/`) authenticated by the\nuser's Bearer API key; the backend validates the key, checks the user is a\nmember of the relevant project, runs the op with its service key, and returns\nthe data. Same method surface as before — only the transport changed."},"1951":{"id":"/docs/evsys_sdk/store-2","page_id":"/docs/evsys_sdk/store","tags":[],"type":"text","url":"/docs/evsys_sdk/store","content":"Env: `EVSYS_API_URL` (backend base URL), `EVSYS_API_KEY` (Bearer),\n`EVSYS_PROJECT_ID` (default project for project-scoped ops)."},"1952":{"id":"/docs/evsys_sdk/store-3","page_id":"/docs/evsys_sdk/store","tags":[],"type":"text","url":"/docs/evsys_sdk/store","content":"<Card title=\"&#x22;EvsysStoreError&#x22;\" href=\"&#x22;/docs/evsys_sdk/store/EvsysStoreError&#x22;\" />"},"1953":{"id":"/docs/evsys_sdk/store-4","page_id":"/docs/evsys_sdk/store","tags":[],"type":"text","url":"/docs/evsys_sdk/store","content":"<Card title=\"&#x22;EvsysStore&#x22;\" href=\"&#x22;/docs/evsys_sdk/store/EvsysStore&#x22;\" />"},"1954":{"id":"/docs/evsys_sdk/transforms","page_id":"/docs/evsys_sdk/transforms","type":"page","content":"transforms","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","transforms"],"tags":[],"url":"/docs/evsys_sdk/transforms"},"1955":{"id":"/docs/evsys_sdk/transforms-0","page_id":"/docs/evsys_sdk/transforms","tags":[],"type":"text","url":"/docs/evsys_sdk/transforms","content":"Built-in transforms. Importing this module registers them."},"1956":{"id":"/docs/evsys_sdk/transforms-1","page_id":"/docs/evsys_sdk/transforms","tags":[],"type":"text","url":"/docs/evsys_sdk/transforms","content":"Built-ins are deliberately generic (`identity`, `jsonl_to_chat`). Domain-specific\ntransforms are written in your own project via `@register_transform` — see the\nSDK reference's \"writing extensions\" section."},"1957":{"id":"/docs/evsys_sdk/transforms-2","page_id":"/docs/evsys_sdk/transforms","tags":[],"type":"text","url":"/docs/evsys_sdk/transforms","content":"<Card href=\"&#x22;/docs/evsys_sdk/transforms/identity&#x22;\" title=\"&#x22;identity&#x22;\" />"},"1958":{"id":"/docs/evsys_sdk/transforms-3","page_id":"/docs/evsys_sdk/transforms","tags":[],"type":"text","url":"/docs/evsys_sdk/transforms","content":"<Card href=\"&#x22;/docs/evsys_sdk/transforms/jsonl_to_chat&#x22;\" title=\"&#x22;jsonl_to_chat&#x22;\" />"},"1959":{"id":"/docs/evsys_sdk/verifiers","page_id":"/docs/evsys_sdk/verifiers","type":"page","content":"verifiers","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","verifiers"],"tags":[],"url":"/docs/evsys_sdk/verifiers"},"1960":{"id":"/docs/evsys_sdk/verifiers-0","page_id":"/docs/evsys_sdk/verifiers","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers","content":"Built-in verifiers."},"1961":{"id":"/docs/evsys_sdk/verifiers-1","page_id":"/docs/evsys_sdk/verifiers","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers","content":"Two layers:"},"1962":{"id":"/docs/evsys_sdk/verifiers-2","page_id":"/docs/evsys_sdk/verifiers","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers","content":"`@register_verifier` *classes* (runtime `Verifier` Protocol)."},"1963":{"id":"/docs/evsys_sdk/verifiers-3","page_id":"/docs/evsys_sdk/verifiers","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers","content":"in-process verifier *functions* in `fns` — the SDK-local registry that\n`InProcessVerifier(fn_name=…)` resolves against (D10: SDK is the single\nsource of truth; the remote stores only `fn_name` + `expected`/`params`)."},"1964":{"id":"/docs/evsys_sdk/verifiers-4","page_id":"/docs/evsys_sdk/verifiers","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers","content":"<Card href=\"&#x22;/docs/evsys_sdk/verifiers/format_only&#x22;\" title=\"&#x22;format_only&#x22;\" />"},"1965":{"id":"/docs/evsys_sdk/verifiers-5","page_id":"/docs/evsys_sdk/verifiers","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers","content":"<Card href=\"&#x22;/docs/evsys_sdk/verifiers/fns&#x22;\" title=\"&#x22;fns&#x22;\" />"},"1966":{"id":"/docs/evsys_sdk/workspace/MaterializedDataset","page_id":"/docs/evsys_sdk/workspace/MaterializedDataset","type":"page","content":"MaterializedDataset","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","workspace"],"tags":[],"url":"/docs/evsys_sdk/workspace/MaterializedDataset"},"1967":{"id":"/docs/evsys_sdk/workspace/MaterializedDataset-0","page_id":"/docs/evsys_sdk/workspace/MaterializedDataset","type":"heading","tags":[],"url":"/docs/evsys_sdk/workspace/MaterializedDataset#attributes","content":"Attributes"},"1968":{"id":"/docs/evsys_sdk/workspace/MaterializedDataset-1","page_id":"/docs/evsys_sdk/workspace/MaterializedDataset","type":"heading","tags":[],"url":"/docs/evsys_sdk/workspace/MaterializedDataset#functions","content":"Functions"},"1969":{"id":"/docs/evsys_sdk/workspace/Workspace","page_id":"/docs/evsys_sdk/workspace/Workspace","type":"page","content":"Workspace","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","workspace"],"tags":[],"url":"/docs/evsys_sdk/workspace/Workspace"},"1970":{"id":"/docs/evsys_sdk/workspace/Workspace-0","page_id":"/docs/evsys_sdk/workspace/Workspace","type":"heading","tags":[],"url":"/docs/evsys_sdk/workspace/Workspace#attributes","content":"Attributes"},"1971":{"id":"/docs/evsys_sdk/workspace/Workspace-1","page_id":"/docs/evsys_sdk/workspace/Workspace","type":"heading","tags":[],"url":"/docs/evsys_sdk/workspace/Workspace#functions","content":"Functions"},"1972":{"id":"/docs/evsys_sdk/workspace/Workspace-2","page_id":"/docs/evsys_sdk/workspace/Wor