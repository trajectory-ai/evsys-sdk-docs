sys_sdk/transforms/jsonl_to_chat","page_id":"/docs/evsys_sdk/transforms/jsonl_to_chat","type":"page","content":"jsonl_to_chat","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","transforms","jsonl_to_chat"],"tags":[],"url":"/docs/evsys_sdk/transforms/jsonl_to_chat"},"2473":{"id":"/docs/evsys_sdk/transforms/jsonl_to_chat-0","page_id":"/docs/evsys_sdk/transforms/jsonl_to_chat","tags":[],"type":"text","url":"/docs/evsys_sdk/transforms/jsonl_to_chat","content":"Generic JSONL row → \\{messages: \\[...]} chat-shaped row."},"2474":{"id":"/docs/evsys_sdk/transforms/jsonl_to_chat-1","page_id":"/docs/evsys_sdk/transforms/jsonl_to_chat","tags":[],"type":"text","url":"/docs/evsys_sdk/transforms/jsonl_to_chat","content":"<Card title=\"&#x22;JSONLToChatConfig&#x22;\" href=\"&#x22;/docs/evsys_sdk/transforms/jsonl_to_chat/JSONLToChatConfig&#x22;\" />"},"2475":{"id":"/docs/evsys_sdk/transforms/jsonl_to_chat-2","page_id":"/docs/evsys_sdk/transforms/jsonl_to_chat","tags":[],"type":"text","url":"/docs/evsys_sdk/transforms/jsonl_to_chat","content":"<Card title=\"&#x22;JSONLToChatTransform&#x22;\" href=\"&#x22;/docs/evsys_sdk/transforms/jsonl_to_chat/JSONLToChatTransform&#x22;\" />"},"2476":{"id":"/docs/evsys_sdk/verifiers/fns","page_id":"/docs/evsys_sdk/verifiers/fns","type":"page","content":"fns","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","verifiers","fns"],"tags":[],"url":"/docs/evsys_sdk/verifiers/fns"},"2477":{"id":"/docs/evsys_sdk/verifiers/fns-0","page_id":"/docs/evsys_sdk/verifiers/fns","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers/fns","content":"In-process verifier functions — the SDK-local registry (D10)."},"2478":{"id":"/docs/evsys_sdk/verifiers/fns-1","page_id":"/docs/evsys_sdk/verifiers/fns","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers/fns","content":"`InProcessVerifier(fn_name=\"tool_calls_match\", expected=..., params=...)` stores\nonly a *reference*; the actual function lives here, in the SDK. This is the\nsingle source of truth for in-process verifier logic — the remote (Supabase)\nnever stores verifier code, only the `fn_name` + per-task `expected`/`params`."},"2479":{"id":"/docs/evsys_sdk/verifiers/fns-2","page_id":"/docs/evsys_sdk/verifiers/fns","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers/fns","content":"Ported from the backend `api/experiments/verifiers.py` `_REGISTRY` so there is\nexactly ONE registry. Resolve with `get(fn_name)`; extend with\n`register(fn_name, fn)` or the `@register_fn(\"name\")` decorator."},"2480":{"id":"/docs/evsys_sdk/verifiers/fns-3","page_id":"/docs/evsys_sdk/verifiers/fns","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers/fns","content":"Reproducibility note: because a task references a verifier by name, the named\nfunction resolves against *this SDK version* — record the SDK version on the\nexperiment/run (see EXPERIMENT\\_AGENT\\_DESIGN.md, D10 / Q-J)."},"2481":{"id":"/docs/evsys_sdk/verifiers/fns-4","page_id":"/docs/evsys_sdk/verifiers/fns","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers/fns","content":"Best-effort: strip code fences, find first JSON object, parse."},"2482":{"id":"/docs/evsys_sdk/verifiers/fns-5","page_id":"/docs/evsys_sdk/verifiers/fns","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers/fns","content":"1.0 if the model's emitted tool call matches expected; else 0.0."},"2483":{"id":"/docs/evsys_sdk/verifiers/fns-6","page_id":"/docs/evsys_sdk/verifiers/fns","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers/fns","content":"Both must parse as JSON dicts; tool + action must match; optional\n`ref`/`text` must match if present in `expected`; `coordinate` must\nbe within `params['coordinate_tolerance']` (default 25)."},"2484":{"id":"/docs/evsys_sdk/verifiers/fns-7","page_id":"/docs/evsys_sdk/verifiers/fns","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers/fns","content":"Strict text equality (after whitespace strip + optional case-fold)."},"2485":{"id":"/docs/evsys_sdk/verifiers/fns-8","page_id":"/docs/evsys_sdk/verifiers/fns","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers/fns","content":"1.0 if `expected` is a substring of model\\_output."},"2486":{"id":"/docs/evsys_sdk/verifiers/fns-9","page_id":"/docs/evsys_sdk/verifiers/fns","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers/fns","content":"1.0 if regex `expected` matches model\\_output."},"2487":{"id":"/docs/evsys_sdk/verifiers/fns-10","page_id":"/docs/evsys_sdk/verifiers/fns","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers/fns","content":"Decorator form of `register`."},"2488":{"id":"/docs/evsys_sdk/verifiers/format_only/FormatOnlyConfig","page_id":"/docs/evsys_sdk/verifiers/format_only/FormatOnlyConfig","type":"page","content":"FormatOnlyConfig","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","verifiers","format_only"],"tags":[],"url":"/docs/evsys_sdk/verifiers/format_only/FormatOnlyConfig"},"2489":{"id":"/docs/evsys_sdk/verifiers/format_only/FormatOnlyConfig-0","page_id":"/docs/evsys_sdk/verifiers/format_only/FormatOnlyConfig","type":"heading","tags":[],"url":"/docs/evsys_sdk/verifiers/format_only/FormatOnlyConfig#attributes","content":"Attributes"},"2490":{"id":"/docs/evsys_sdk/verifiers/format_only/FormatOnlyVerifier","page_id":"/docs/evsys_sdk/verifiers/format_only/FormatOnlyVerifier","type":"page","content":"FormatOnlyVerifier","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","verifiers","format_only"],"tags":[],"url":"/docs/evsys_sdk/verifiers/format_only/FormatOnlyVerifier"},"2491":{"id":"/docs/evsys_sdk/verifiers/format_only/FormatOnlyVerifier-0","page_id":"/docs/evsys_sdk/verifiers/format_only/FormatOnlyVerifier","type":"heading","tags":[],"url":"/docs/evsys_sdk/verifiers/format_only/FormatOnlyVerifier#attributes","content":"Attributes"},"2492":{"id":"/docs/evsys_sdk/verifiers/format_only/FormatOnlyVerifier-1","page_id":"/docs/evsys_sdk/verifiers/format_only/FormatOnlyVerifier","type":"heading","tags":[],"url":"/docs/evsys_sdk/verifiers/format_only/FormatOnlyVerifier#functions","content":"Functions"},"2493":{"id":"/docs/evsys_sdk/verifiers/format_only","page_id":"/docs/evsys_sdk/verifiers/format_only","type":"page","content":"format_only","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","verifiers","format_only"],"tags":[],"url":"/docs/evsys_sdk/verifiers/format_only"},"2494":{"id":"/docs/evsys_sdk/verifiers/format_only-0","page_id":"/docs/evsys_sdk/verifiers/format_only","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers/format_only","content":"FormatOnlyVerifier — rewards only structural compliance with \\<think>/\\<answer>."},"2495":{"id":"/docs/evsys_sdk/verifiers/format_only-1","page_id":"/docs/evsys_sdk/verifiers/format_only","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers/format_only","content":"<Card title=\"&#x22;FormatOnlyConfig&#x22;\" href=\"&#x22;/docs/evsys_sdk/verifiers/format_only/FormatOnlyConfig&#x22;\" />"},"2496":{"id":"/docs/evsys_sdk/verifiers/format_only-2","page_id":"/docs/evsys_sdk/verifiers/format_only","tags":[],"type":"text","url":"/docs/evsys_sdk/verifiers/format_only","content":"<Card title=\"&#x22;FormatOnlyVerifier&#x22;\" href=\"&#x22;/docs/evsys_sdk/verifiers/format_only/FormatOnlyVerifier&#x22;\" />"},"2497":{"id":"/docs/evsys_sdk/training/batch_utils","page_id":"/docs/evsys_sdk/training/batch_utils","type":"page","content":"batch_utils","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","batch_utils"],"tags":[],"url":"/docs/evsys_sdk/training/batch_utils"},"2498":{"id":"/docs/evsys_sdk/training/batch_utils-0","page_id":"/docs/evsys_sdk/training/batch_utils","tags":[],"type":"text","url":"/docs/evsys_sdk/training/batch_utils","content":"Small shared helpers for turning backend forward-backward / sampling\noutputs into plain Python, used by the SFT / SDFT algorithms' `step_metrics`\nand batch construction."},"2499":{"id":"/docs/evsys_sdk/training/batch_utils-1","page_id":"/docs/evsys_sdk/training/batch_utils","tags":[],"type":"text","url":"/docs/evsys_sdk/training/batch_utils","content":"Kept backend-agnostic: `MockBackend` emits Python lists; the real\n`TinkerBackend` emits `tinker.TensorData` (with `.to_torch()`) and\ntinker `SamplingResponse` objects. These helpers normalize both."},"2500":{"id":"/docs/evsys_sdk/training/batch_utils-2","page_id":"/docs/evsys_sdk/training/batch_utils","tags":[],"type":"text","url":"/docs/evsys_sdk/training/batch_utils","content":"Best-effort: turn a TensorData / list / torch.Tensor into list\\[float]."},"2501":{"id":"/docs/evsys_sdk/training/batch_utils-3","page_id":"/docs/evsys_sdk/training/batch_utils","tags":[],"type":"text","url":"/docs/evsys_sdk/training/batch_utils","content":"Returns `None` when the value can't be coerced (so callers can skip it)."},"2502":{"id":"/docs/evsys_sdk/training/batch_utils-4","page_id":"/docs/evsys_sdk/training/batch_utils","tags":[],"type":"text","url":"/docs/evsys_sdk/training/batch_utils","content":"Flatten an arbitrarily-nested list of numbers to `list[float]`.\nReturns `None` if a leaf isn't coercible to float."},"2503":{"id":"/docs/evsys_sdk/training/batch_utils-5","page_id":"/docs/evsys_sdk/training/batch_utils","tags":[],"type":"text","url":"/docs/evsys_sdk/training/batch_utils","content":"Pull the per-position weight mask out of a Datum's loss\\_fn\\_inputs."},"2504":{"id":"/docs/evsys_sdk/training/batch_utils-6","page_id":"/docs/evsys_sdk/training/batch_utils","tags":[],"type":"text","url":"/docs/evsys_sdk/training/batch_utils","content":"Pull the token-id list out of a tinker SamplingResponse-shape object."},"2505":{"id":"/docs/evsys_sdk/training/batch_utils-7","page_id":"/docs/evsys_sdk/training/batch_utils","tags":[],"type":"text","url":"/docs/evsys_sdk/training/batch_utils","content":"Real tinker exposes `.sequences[0].tokens`; MockSamplingClient does the\nsame; either way we get a list of ints back."},"2506":{"id":"/docs/evsys_sdk/training/backend/Backend","page_id":"/docs/evsys_sdk/training/backend/Backend","type":"page","content":"Backend","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","backend"],"tags":[],"url":"/docs/evsys_sdk/training/backend/Backend"},"2507":{"id":"/docs/evsys_sdk/training/backend/Backend-0","page_id":"/docs/evsys_sdk/training/backend/Backend","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/backend/Backend#functions","content":"Functions"},"2508":{"id":"/docs/evsys_sdk/training/backend/Backend-1","page_id":"/docs/evsys_sdk/training/backend/Backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/Backend","content":"Wraps a training client + factory for sampling clients."},"2509":{"id":"/docs/evsys_sdk/training/backend/Backend-2","page_id":"/docs/evsys_sdk/training/backend/Backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/Backend","content":"A `Backend` is constructed once per run (typically by the Algorithm\ncomposer, see :mod:`evsys_sdk.algorithms.sft`). It owns the\nlive training client; everything else in the package operates against\nthis Protocol."},"2510":{"id":"/docs/evsys_sdk/training/backend/Backend-3","page_id":"/docs/evsys_sdk/training/backend/Backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/Backend#functions","content":"Submit a forward + backward pass with a named server-side loss."},"2511":{"id":"/docs/evsys_sdk/training/backend/Backend-4","page_id":"/docs/evsys_sdk/training/backend/Backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/Backend#functions","content":"Returns an awaitable that resolves to a :class:`ForwardBackwardResult`.\nTinker's loss names are `\"cross_entropy\"` (with per-position weights\non Datum.loss\\_fn\\_inputs\\[\"weights\"]) and `\"importance_sampling\"`\n(with advantages on Datum.loss\\_fn\\_inputs\\[\"advantages\"])."},"2512":{"id":"/docs/evsys_sdk/training/backend/Backend-5","page_id":"/docs/evsys_sdk/training/backend/Backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/Backend#functions","content":"Same as :meth:`forward_backward_async`, but the loss is a\nclient-side Python callable."},"2513":{"id":"/docs/evsys_sdk/training/backend/Backend-6","page_id":"/docs/evsys_sdk/training/backend/Backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/Backend#functions","content":"Tinker streams logits/logprobs back, the callable runs locally on\neach Datum, and the returned scalar gets sent back for the backward\npass. This is the same hook SDFT uses for analytical reverse-KL,\nexposed here as a first-class extension point."},"2514":{"id":"/docs/evsys_sdk/training/backend/Backend-7","page_id":"/docs/evsys_sdk/training/backend/Backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/Backend#functions","content":"Optimizer step. Returns an awaitable resolving to :class:`OptimStepResult`."},"2515":{"id":"/docs/evsys_sdk/training/backend/Backend-8","page_id":"/docs/evsys_sdk/training/backend/Backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/Backend#functions","content":"Snapshot the current weights for inference. Returns the sampler URI."},"2516":{"id":"/docs/evsys_sdk/training/backend/Backend-9","page_id":"/docs/evsys_sdk/training/backend/Backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/Backend#functions","content":"Snapshot weights + optimizer state for resume. Returns the URI."},"2517":{"id":"/docs/evsys_sdk/training/backend/Backend-10","page_id":"/docs/evsys_sdk/training/backend/Backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/Backend#functions","content":"Save\\_weights\\_for\\_sampler + construct an inference client at that URI."},"2518":{"id":"/docs/evsys_sdk/training/backend/Backend-11","page_id":"/docs/evsys_sdk/training/backend/Backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/Backend#functions","content":"Convenience for the in-loop eval slot, which needs both: save the\nlatest weights AND get a client that can sample from them. The\nmanager records the URI; the eval slot uses the client."},"2519":{"id":"/docs/evsys_sdk/training/backend/Backend-12","page_id":"/docs/evsys_sdk/training/backend/Backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/Backend#functions","content":"HF tokenizer the backend is using. Used by StepBuilders that need\nto tokenize text (SFT) or apply chat templates (SDFT)."},"2520":{"id":"/docs/evsys_sdk/training/backend/ForwardBackwardResult","page_id":"/docs/evsys_sdk/training/backend/ForwardBackwardResult","type":"page","content":"ForwardBackwardResult","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","backend"],"tags":[],"url":"/docs/evsys_sdk/training/backend/ForwardBackwardResult"},"2521":{"id":"/docs/evsys_sdk/training/backend/ForwardBackwardResult-0","page_id":"/docs/evsys_sdk/training/backend/ForwardBackwardResult","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/backend/ForwardBackwardResult#attributes","content":"Attributes"},"2522":{"id":"/docs/evsys_sdk/training/backend/ForwardBackwardResult-1","page_id":"/docs/evsys_sdk/training/backend/ForwardBackwardResult","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/ForwardBackwardResult","content":"What `forward_backward_*_async` resolves to."},"2523":{"id":"/docs/evsys_sdk/training/backend/ForwardBackwardResult-2","page_id":"/docs/evsys_sdk/training/backend/ForwardBackwardResult","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/ForwardBackwardResult","content":"Tinker's own `ForwardBackwardOutput` is opaque (pydantic with no public\nattrs in the installed version), so consumers go through the loss\\_fn\\_outputs\nfield on the actual response. The Protocol here lists what the loop reads\nso the contract is explicit; MockBackend constructs duck-typed objects."},"2524":{"id":"/docs/evsys_sdk/training/backend/ForwardBackwardResult-3","page_id":"/docs/evsys_sdk/training/backend/ForwardBackwardResult","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/ForwardBackwardResult#attributes","content":"One entry per Datum. Each carries algorithm-specific keys —\n`\"logprobs\"` for cross\\_entropy, `\"loss\"` / `\"advantage_sum\"` for IS, etc."},"2525":{"id":"/docs/evsys_sdk/training/backend/MockBackend","page_id":"/docs/evsys_sdk/training/backend/MockBackend","type":"page","content":"MockBackend","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","backend"],"tags":[],"url":"/docs/evsys_sdk/training/backend/MockBackend"},"2526":{"id":"/docs/evsys_sdk/training/backend/MockBackend-0","page_id":"/docs/evsys_sdk/training/backend/MockBackend","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/backend/MockBackend#attributes","content":"Attributes"},"2527":{"id":"/docs/evsys_sdk/training/backend/MockBackend-1","page_id":"/docs/evsys_sdk/training/backend/MockBackend","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/backend/MockBackend#functions","content":"Functions"},"2528":{"id":"/docs/evsys_sdk/training/backend/MockBackend-2","page_id":"/docs/evsys_sdk/training/backend/MockBackend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/MockBackend","content":"In-memory Backend for tests."},"2529":{"id":"/docs/evsys_sdk/training/backend/MockBackend-3","page_id":"/docs/evsys_sdk/training/backend/MockBackend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/MockBackend","content":"Records every call to `forward_backward_async` /\n`forward_backward_custom_async` / `optim_step_async` /\n`save_for_sampler` / `save_full_state` /\n`snapshot_sampling_client` for assertion. Returns predictable result\nobjects so the loop's metric / save / eval paths exercise end-to-end."},"2530":{"id":"/docs/evsys_sdk/training/backend/MockSamplingClient","page_id":"/docs/evsys_sdk/training/backend/MockSamplingClient","type":"page","content":"MockSamplingClient","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","backend"],"tags":[],"url":"/docs/evsys_sdk/training/backend/MockSamplingClient"},"2531":{"id":"/docs/evsys_sdk/training/backend/MockSamplingClient-0","page_id":"/docs/evsys_sdk/training/backend/MockSamplingClient","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/backend/MockSamplingClient#attributes","content":"Attributes"},"2532":{"id":"/docs/evsys_sdk/training/backend/MockSamplingClient-1","page_id":"/docs/evsys_sdk/training/backend/MockSamplingClient","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/backend/MockSamplingClient#functions","content":"Functions"},"2533":{"id":"/docs/evsys_sdk/training/backend/MockSamplingClient-2","page_id":"/docs/evsys_sdk/training/backend/MockSamplingClient","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/MockSamplingClient","content":"In-memory SamplingClient for tests."},"2534":{"id":"/docs/evsys_sdk/training/backend/MockSamplingClient-3","page_id":"/docs/evsys_sdk/training/backend/MockSamplingClient","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/MockSamplingClient","content":"Returns `canned[i % len(canned)]` per call to `sample_async`. Tests\nthat need fancy behavior can subclass; the default is enough to exercise\nthe loop's eval slot."},"2535":{"id":"/docs/evsys_sdk/training/backend/OptimStepResult","page_id":"/docs/evsys_sdk/training/backend/OptimStepResult","type":"page","content":"OptimStepResult","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","backend"],"tags":[],"url":"/docs/evsys_sdk/training/backend/OptimStepResult"},"2536":{"id":"/docs/evsys_sdk/training/backend/OptimStepResult-0","page_id":"/docs/evsys_sdk/training/backend/OptimStepResult","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/backend/OptimStepResult#attributes","content":"Attributes"},"2537":{"id":"/docs/evsys_sdk/training/backend/OptimStepResult-1","page_id":"/docs/evsys_sdk/training/backend/OptimStepResult","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/OptimStepResult#attributes","content":"Optimizer-side metrics emitted by tinker (`optim/lr`, gradient norms,\netc.). The loop merges these into the per-step record."},"2538":{"id":"/docs/evsys_sdk/training/backend/SamplingClient","page_id":"/docs/evsys_sdk/training/backend/SamplingClient","type":"page","content":"SamplingClient","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","backend"],"tags":[],"url":"/docs/evsys_sdk/training/backend/SamplingClient"},"2539":{"id":"/docs/evsys_sdk/training/backend/SamplingClient-0","page_id":"/docs/evsys_sdk/training/backend/SamplingClient","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/backend/SamplingClient#functions","content":"Functions"},"2540":{"id":"/docs/evsys_sdk/training/backend/SamplingClient-1","page_id":"/docs/evsys_sdk/training/backend/SamplingClient","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/SamplingClient","content":"Inference-only client backed by a saved sampler checkpoint."},"2541":{"id":"/docs/evsys_sdk/training/backend/SamplingClient-2","page_id":"/docs/evsys_sdk/training/backend/SamplingClient","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/SamplingClient","content":"Created by :meth:`Backend.snapshot_sampling_client`. Both the loop's\nin-loop eval slot and any rollout-based StepBuilder (SDFT, RL) consume\nthis surface — never the underlying tinker client directly."},"2542":{"id":"/docs/evsys_sdk/training/backend/SamplingClient-3","page_id":"/docs/evsys_sdk/training/backend/SamplingClient","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/SamplingClient#functions","content":"Generate tokens for `prompt`. Return shape is backend-defined."},"2543":{"id":"/docs/evsys_sdk/training/backend/SamplingClient-4","page_id":"/docs/evsys_sdk/training/backend/SamplingClient","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/SamplingClient#functions","content":"TinkerBackend returns tinker's native `SamplingResponse` with\n`.sequences` (one per sample) and optional `.topk_prompt_logprobs`.\nMockBackend returns canned strings for tests."},"2544":{"id":"/docs/evsys_sdk/training/backend/SamplingClient-5","page_id":"/docs/evsys_sdk/training/backend/SamplingClient","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/SamplingClient#functions","content":"Per-position logprobs of the prompt under the current weights."},"2545":{"id":"/docs/evsys_sdk/training/backend/_MockResult","page_id":"/docs/evsys_sdk/training/backend/_MockResult","type":"page","content":"_MockResult","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","backend"],"tags":[],"url":"/docs/evsys_sdk/training/backend/_MockResult"},"2546":{"id":"/docs/evsys_sdk/training/backend/_MockResult-0","page_id":"/docs/evsys_sdk/training/backend/_MockResult","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/backend/_MockResult#functions","content":"Functions"},"2547":{"id":"/docs/evsys_sdk/training/backend/_MockResult-1","page_id":"/docs/evsys_sdk/training/backend/_MockResult","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/_MockResult","content":"Duck-typed ForwardBackwardResult / OptimStepResult."},"2548":{"id":"/docs/evsys_sdk/training/backend/_ResolvedFuture","page_id":"/docs/evsys_sdk/training/backend/_ResolvedFuture","type":"page","content":"_ResolvedFuture","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","backend"],"tags":[],"url":"/docs/evsys_sdk/training/backend/_ResolvedFuture"},"2549":{"id":"/docs/evsys_sdk/training/backend/_ResolvedFuture-0","page_id":"/docs/evsys_sdk/training/backend/_ResolvedFuture","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/backend/_ResolvedFuture#functions","content":"Functions"},"2550":{"id":"/docs/evsys_sdk/training/backend/_ResolvedFuture-1","page_id":"/docs/evsys_sdk/training/backend/_ResolvedFuture","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend/_ResolvedFuture","content":"Tinker-style future with `.result_async()` resolving to a value."},"2551":{"id":"/docs/evsys_sdk/training/backend","page_id":"/docs/evsys_sdk/training/backend","type":"page","content":"backend","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","backend"],"tags":[],"url":"/docs/evsys_sdk/training/backend"},"2552":{"id":"/docs/evsys_sdk/training/backend-0","page_id":"/docs/evsys_sdk/training/backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend","content":"Backend — the only surface that talks to tinker."},"2553":{"id":"/docs/evsys_sdk/training/backend-1","page_id":"/docs/evsys_sdk/training/backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend","content":"The `Backend` Protocol is the seam the rest of the training stack is built\nagainst. A concrete backend (:class:`~evsys_sdk.training.backend.MockBackend`\nfor tests; the future `TinkerBackend` for real runs) implements the\nsix-method contract and the rest of the package (loop, step builders,\ncheckpoint manager) stays backend-agnostic. That's how we drop the\ntinker\\_cookbook dependency without locking ourselves to tinker either."},"2554":{"id":"/docs/evsys_sdk/training/backend-2","page_id":"/docs/evsys_sdk/training/backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend","content":"Method shape mirrors tinker's own client so a TinkerBackend implementation\nis one-to-one plumbing — see the docstrings on each method for the\ncontract."},"2555":{"id":"/docs/evsys_sdk/training/backend-3","page_id":"/docs/evsys_sdk/training/backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend","content":"Custom client-side loss. Receives `(model_output, batch_metadata)` and\nreturns a scalar (typically a `torch.Tensor`) the backend uses for the\nbackward pass. The exact shape of `model_output` is backend-defined —\nTinkerBackend passes `tinker.ForwardOutput` here."},"2556":{"id":"/docs/evsys_sdk/training/backend-4","page_id":"/docs/evsys_sdk/training/backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend","content":"<Card title=\"&#x22;ForwardBackwardResult&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/backend/ForwardBackwardResult&#x22;\" />"},"2557":{"id":"/docs/evsys_sdk/training/backend-5","page_id":"/docs/evsys_sdk/training/backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend","content":"<Card title=\"&#x22;OptimStepResult&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/backend/OptimStepResult&#x22;\" />"},"2558":{"id":"/docs/evsys_sdk/training/backend-6","page_id":"/docs/evsys_sdk/training/backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend","content":"<Card title=\"&#x22;SamplingClient&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/backend/SamplingClient&#x22;\" />"},"2559":{"id":"/docs/evsys_sdk/training/backend-7","page_id":"/docs/evsys_sdk/training/backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend","content":"<Card title=\"&#x22;Backend&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/backend/Backend&#x22;\" />"},"2560":{"id":"/docs/evsys_sdk/training/backend-8","page_id":"/docs/evsys_sdk/training/backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend","content":"<Card title=\"&#x22;_ResolvedFuture&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/backend/_ResolvedFuture&#x22;\" />"},"2561":{"id":"/docs/evsys_sdk/training/backend-9","page_id":"/docs/evsys_sdk/training/backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend","content":"<Card title=\"&#x22;_MockResult&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/backend/_MockResult&#x22;\" />"},"2562":{"id":"/docs/evsys_sdk/training/backend-10","page_id":"/docs/evsys_sdk/training/backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend","content":"<Card title=\"&#x22;MockSamplingClient&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/backend/MockSamplingClient&#x22;\" />"},"2563":{"id":"/docs/evsys_sdk/training/backend-11","page_id":"/docs/evsys_sdk/training/backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/backend","content":"<Card title=\"&#x22;MockBackend&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/backend/MockBackend&#x22;\" />"},"2564":{"id":"/docs/evsys_sdk/training/callbacks/Callback","page_id":"/docs/evsys_sdk/training/callbacks/Callback","type":"page","content":"Callback","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/Callback"},"2565":{"id":"/docs/evsys_sdk/training/callbacks/Callback-0","page_id":"/docs/evsys_sdk/training/callbacks/Callback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/Callback#functions","content":"Functions"},"2566":{"id":"/docs/evsys_sdk/training/callbacks/Callback-1","page_id":"/docs/evsys_sdk/training/callbacks/Callback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/Callback","content":"Override any of these. Defaults are no-ops so callbacks don't have to\nimplement every hook."},"2567":{"id":"/docs/evsys_sdk/training/callbacks/Callback-2","page_id":"/docs/evsys_sdk/training/callbacks/Callback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/Callback","content":"Hook signatures are positional + typed (not a generic event-bag) so\nIDE autocomplete and static type checking still work. Each hook fires\nat exactly one moment in the loop — see the docstrings."},"2568":{"id":"/docs/evsys_sdk/training/callbacks/Callback-3","page_id":"/docs/evsys_sdk/training/callbacks/Callback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/Callback","content":"All hooks are sync (`def`, not `async`). If you need to schedule\nasync work, spawn `asyncio.create_task(...)` from inside the hook."},"2569":{"id":"/docs/evsys_sdk/training/callbacks/Callback-4","page_id":"/docs/evsys_sdk/training/callbacks/Callback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/Callback#functions","content":"Fires once before the for-loop starts. Open log files, register\na wandb run, snapshot the config — anything that should happen\nbefore the first step."},"2570":{"id":"/docs/evsys_sdk/training/callbacks/Callback-5","page_id":"/docs/evsys_sdk/training/callbacks/Callback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/Callback#functions","content":"Fires once after the loop completes (including the final\ncheckpoint save). Flush summary writes, close files."},"2571":{"id":"/docs/evsys_sdk/training/callbacks/Callback-6","page_id":"/docs/evsys_sdk/training/callbacks/Callback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/Callback#functions","content":"Fires after every train step's metric row is written. The\nuniversal \"do something per step\" hook (printing, plotting,\ncustom metric derivations, gradient debugging)."},"2572":{"id":"/docs/evsys_sdk/training/callbacks/Callback-7","page_id":"/docs/evsys_sdk/training/callbacks/Callback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/Callback#functions","content":"Fires after each checkpoint manifest row is recorded. Useful\nfor shipping to S3, pruning old checkpoints, kicking a side eval."},"2573":{"id":"/docs/evsys_sdk/training/callbacks/Callback-8","page_id":"/docs/evsys_sdk/training/callbacks/Callback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/Callback#functions","content":"Fires per evaluator after each in-loop eval completes. Useful\nfor pushing to a dashboard, plotting val curves, driving\nearly-stopping decisions. (Logger callbacks that also need the\nrollout predictions should use :meth:`on_benchmark_eval`, which the\nloop fires for benchmark evaluators with the full payload.)"},"2574":{"id":"/docs/evsys_sdk/training/callbacks/Callback-9","page_id":"/docs/evsys_sdk/training/callbacks/Callback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/Callback#functions","content":"Fires once at the start of an experiment, before any arm. A logger\ncreates the experiment record here (`ctx.ids['experiment_id'] = ...`)."},"2575":{"id":"/docs/evsys_sdk/training/callbacks/Callback-10","page_id":"/docs/evsys_sdk/training/callbacks/Callback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/Callback#functions","content":"Fires when a new run-group is needed (n\\_repeats replicates or\ncontinual stages). A logger creates the group\n(`ctx.ids[f'group:\\{group_name\\}'] = ...`)."},"2576":{"id":"/docs/evsys_sdk/training/callbacks/Callback-11","page_id":"/docs/evsys_sdk/training/callbacks/Callback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/Callback#functions","content":"Fires per arm, before training. `ctx.run_config` is set. A logger\nopens its run-scoped sink (wandb.init / create\\_run →\n`ctx.ids['run_id']`), reading `ctx.ids['experiment_id']` /\n`ctx.ids[f'group:\\{ctx.group_name\\}']` to parent it."},"2577":{"id":"/docs/evsys_sdk/training/callbacks/Callback-12","page_id":"/docs/evsys_sdk/training/callbacks/Callback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/Callback#functions","content":"Fires per benchmark scored — in-loop (`step` = the train step) or\npost-training (`step=None`). Carries metrics + breakdowns + tags\n(on `eval_result`) AND the per-task prediction rows. A logger\ncreates one eval row per `(eval_result.name, step)` and persists the\npredictions."},"2578":{"id":"/docs/evsys_sdk/training/callbacks/Callback-13","page_id":"/docs/evsys_sdk/training/callbacks/Callback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/Callback#functions","content":"Fires per arm, after eval, before the run is marked completed. A\nlogger flushes/closes its run-scoped sink (wandb.finish) and records\nthe final status (update\\_run)."},"2579":{"id":"/docs/evsys_sdk/training/callbacks/Callback-14","page_id":"/docs/evsys_sdk/training/callbacks/Callback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/Callback#functions","content":"Fires once at the end of the experiment. Final summary / flush."},"2580":{"id":"/docs/evsys_sdk/training/callbacks/CsvMetricsCallback","page_id":"/docs/evsys_sdk/training/callbacks/CsvMetricsCallback","type":"page","content":"CsvMetricsCallback","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/CsvMetricsCallback"},"2581":{"id":"/docs/evsys_sdk/training/callbacks/CsvMetricsCallback-0","page_id":"/docs/evsys_sdk/training/callbacks/CsvMetricsCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/CsvMetricsCallback#attributes","content":"Attributes"},"2582":{"id":"/docs/evsys_sdk/training/callbacks/CsvMetricsCallback-1","page_id":"/docs/evsys_sdk/training/callbacks/CsvMetricsCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/CsvMetricsCallback#functions","content":"Functions"},"2583":{"id":"/docs/evsys_sdk/training/callbacks/CsvMetricsCallback-2","page_id":"/docs/evsys_sdk/training/callbacks/CsvMetricsCallback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/CsvMetricsCallback","content":"Mirror the loop's per-step metric writes into a CSV alongside\n`metrics.jsonl`. Friendly for pandas / spreadsheet inspection."},"2584":{"id":"/docs/evsys_sdk/training/callbacks/CsvMetricsConfig","page_id":"/docs/evsys_sdk/training/callbacks/CsvMetricsConfig","type":"page","content":"CsvMetricsConfig","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/CsvMetricsConfig"},"2585":{"id":"/docs/evsys_sdk/training/callbacks/CsvMetricsConfig-0","page_id":"/docs/evsys_sdk/training/callbacks/CsvMetricsConfig","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/CsvMetricsConfig#attributes","content":"Attributes"},"2586":{"id":"/docs/evsys_sdk/training/callbacks/DebugLoggerCallback","page_id":"/docs/evsys_sdk/training/callbacks/DebugLoggerCallback","type":"page","content":"DebugLoggerCallback","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/DebugLoggerCallback"},"2587":{"id":"/docs/evsys_sdk/training/callbacks/DebugLoggerCallback-0","page_id":"/docs/evsys_sdk/training/callbacks/DebugLoggerCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/DebugLoggerCallback#attributes","content":"Attributes"},"2588":{"id":"/docs/evsys_sdk/training/callbacks/DebugLoggerCallback-1","page_id":"/docs/evsys_sdk/training/callbacks/DebugLoggerCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/DebugLoggerCallback#functions","content":"Functions"},"2589":{"id":"/docs/evsys_sdk/training/callbacks/DebugLoggerCallback-2","page_id":"/docs/evsys_sdk/training/callbacks/DebugLoggerCallback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/DebugLoggerCallback","content":"Pretty-print EVERYTHING handed to each callback hook — every lifecycle\nand loop event, with its arguments summarized. Pure introspection (no\npersistence); drop it into `callbacks:` to see exactly what the logger\ncallbacks receive and in what order."},"2590":{"id":"/docs/evsys_sdk/training/callbacks/DebugLoggerConfig","page_id":"/docs/evsys_sdk/training/callbacks/DebugLoggerConfig","type":"page","content":"DebugLoggerConfig","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/DebugLoggerConfig"},"2591":{"id":"/docs/evsys_sdk/training/callbacks/DebugLoggerConfig-0","page_id":"/docs/evsys_sdk/training/callbacks/DebugLoggerConfig","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/DebugLoggerConfig#attributes","content":"Attributes"},"2592":{"id":"/docs/evsys_sdk/training/callbacks/EarlyStoppingCallback","page_id":"/docs/evsys_sdk/training/callbacks/EarlyStoppingCallback","type":"page","content":"EarlyStoppingCallback","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/EarlyStoppingCallback"},"2593":{"id":"/docs/evsys_sdk/training/callbacks/EarlyStoppingCallback-0","page_id":"/docs/evsys_sdk/training/callbacks/EarlyStoppingCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/EarlyStoppingCallback#attributes","content":"Attributes"},"2594":{"id":"/docs/evsys_sdk/training/callbacks/EarlyStoppingCallback-1","page_id":"/docs/evsys_sdk/training/callbacks/EarlyStoppingCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/EarlyStoppingCallback#functions","content":"Functions"},"2595":{"id":"/docs/evsys_sdk/training/callbacks/EarlyStoppingCallback-2","page_id":"/docs/evsys_sdk/training/callbacks/EarlyStoppingCallback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/EarlyStoppingCallback","content":"Watch a metric emitted on eval; request\\_stop after N evals without\nimprovement."},"2596":{"id":"/docs/evsys_sdk/training/callbacks/EarlyStoppingConfig","page_id":"/docs/evsys_sdk/training/callbacks/EarlyStoppingConfig","type":"page","content":"EarlyStoppingConfig","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/EarlyStoppingConfig"},"2597":{"id":"/docs/evsys_sdk/training/callbacks/EarlyStoppingConfig-0","page_id":"/docs/evsys_sdk/training/callbacks/EarlyStoppingConfig","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/EarlyStoppingConfig#attributes","content":"Attributes"},"2598":{"id":"/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback","page_id":"/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback","type":"page","content":"EvsysLoggerCallback","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback"},"2599":{"id":"/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback-0","page_id":"/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback#attributes","content":"Attributes"},"2600":{"id":"/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback-1","page_id":"/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback#functions","content":"Functions"},"2601":{"id":"/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback-2","page_id":"/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback","content":"Persist EVERYTHING to the evsys dashboard store via callbacks — the\nexperiment/group/run records, per-step metrics, checkpoints, and benchmark\nevals + predictions. Keyed off the shared `ctx.ids` it populates\n(`experiment_id` → `group:\\<name>` → `run_id`)."},"2602":{"id":"/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback-3","page_id":"/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback","content":"This is the \"callbacks own the store\" mode: construct `Experiment` WITHOUT\na `store=` (so the orchestrator makes no store calls) and add this\ncallback instead. If `Experiment` already has a store (`ctx.store` set),\nthis callback disables itself to avoid double-writing. The store handle is\nbuilt lazily from the environment (EvsysStore) unless one is injected\n(`cb._store = ...`) — the test seam."},"2603":{"id":"/docs/evsys_sdk/training/callbacks/EvsysLoggerConfig","page_id":"/docs/evsys_sdk/training/callbacks/EvsysLoggerConfig","type":"page","content":"EvsysLoggerConfig","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/EvsysLoggerConfig"},"2604":{"id":"/docs/evsys_sdk/training/callbacks/EvsysLoggerConfig-0","page_id":"/docs/evsys_sdk/training/callbacks/EvsysLoggerConfig","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/EvsysLoggerConfig#attributes","content":"Attributes"},"2605":{"id":"/docs/evsys_sdk/training/callbacks/LocalLoggerCallback","page_id":"/docs/evsys_sdk/training/callbacks/LocalLoggerCallback","type":"page","content":"LocalLoggerCallback","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/LocalLoggerCallback"},"2606":{"id":"/docs/evsys_sdk/training/callbacks/LocalLoggerCallback-0","page_id":"/docs/evsys_sdk/training/callbacks/LocalLoggerCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/LocalLoggerCallback#attributes","content":"Attributes"},"2607":{"id":"/docs/evsys_sdk/training/callbacks/LocalLoggerCallback-1","page_id":"/docs/evsys_sdk/training/callbacks/LocalLoggerCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/LocalLoggerCallback#functions","content":"Functions"},"2608":{"id":"/docs/evsys_sdk/training/callbacks/LocalLoggerCallback-2","page_id":"/docs/evsys_sdk/training/callbacks/LocalLoggerCallback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/LocalLoggerCallback","content":"Human-readable local logging: prints what's happening per step AND\npersists metrics + benchmark predictions to files under the run dir."},"2609":{"id":"/docs/evsys_sdk/training/callbacks/LocalLoggerCallback-3","page_id":"/docs/evsys_sdk/training/callbacks/LocalLoggerCallback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/LocalLoggerCallback","content":"Writes `\\<output_dir>/\\<run_key>/` : `metrics.jsonl` (train + val rows),\n`predictions/\\<name>.jsonl` (per benchmark), and `summary.md` at\nrun end. The \"print what's happening\" requirement is the per-step one-liner\n(cadence `print_every`)."},"2610":{"id":"/docs/evsys_sdk/training/callbacks/LocalLoggerConfig","page_id":"/docs/evsys_sdk/training/callbacks/LocalLoggerConfig","type":"page","content":"LocalLoggerConfig","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/LocalLoggerConfig"},"2611":{"id":"/docs/evsys_sdk/training/callbacks/LocalLoggerConfig-0","page_id":"/docs/evsys_sdk/training/callbacks/LocalLoggerConfig","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/LocalLoggerConfig#attributes","content":"Attributes"},"2612":{"id":"/docs/evsys_sdk/training/callbacks/LogContext","page_id":"/docs/evsys_sdk/training/callbacks/LogContext","type":"page","content":"LogContext","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/LogContext"},"2613":{"id":"/docs/evsys_sdk/training/callbacks/LogContext-0","page_id":"/docs/evsys_sdk/training/callbacks/LogContext","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/LogContext#attributes","content":"Attributes"},"2614":{"id":"/docs/evsys_sdk/training/callbacks/LogContext-1","page_id":"/docs/evsys_sdk/training/callbacks/LogContext","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/LogContext#functions","content":"Functions"},"2615":{"id":"/docs/evsys_sdk/training/callbacks/LogContext-2","page_id":"/docs/evsys_sdk/training/callbacks/LogContext","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/LogContext","content":"Mutable context threaded to every callback hook, in BOTH the\nExperiment scope (lifecycle / benchmark eval) and the TrainingLoop scope\n(per-step / checkpoint). Logger callbacks *create* the dashboard ids and\nwrite them onto :attr:`ids`; later hooks read them back."},"2616":{"id":"/docs/evsys_sdk/training/callbacks/LogContext-3","page_id":"/docs/evsys_sdk/training/callbacks/LogContext","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/LogContext","content":"The framework owns only :attr:`run_key` (the local output-dir name). All\ndashboard ids (`experiment_id` / `group:\\<name>` / `run_id`) are\ncallback-owned and accumulate on :attr:`ids` as the `create_*` hooks\nfire. Arms run sequentially, so `ids[\"run_id\"]` is the current arm's."},"2617":{"id":"/docs/evsys_sdk/training/callbacks/LogContext-4","page_id":"/docs/evsys_sdk/training/callbacks/LogContext","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/LogContext#attributes","content":"Resolved store handle (EvsysStore / LocalStore / DashboardClient) or\nNone when no store is configured."},"2618":{"id":"/docs/evsys_sdk/training/callbacks/LogContext-5","page_id":"/docs/evsys_sdk/training/callbacks/LogContext","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/LogContext#attributes","content":"Callback-populated dashboard ids: `experiment_id`, `group:\\<name>`,\n`run_id`. Read parents here to link children (e.g. create\\_run reads\n`ids['experiment_id']`)."},"2619":{"id":"/docs/evsys_sdk/training/callbacks/LogContext-6","page_id":"/docs/evsys_sdk/training/callbacks/LogContext","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/LogContext#attributes","content":"Scratch for passing values between callbacks within a run (e.g.\n`wandb_url` set by wandb\\_logger, read by evsys\\_logger's create\\_run)."},"2620":{"id":"/docs/evsys_sdk/training/callbacks/LoopState","page_id":"/docs/evsys_sdk/training/callbacks/LoopState","type":"page","content":"LoopState","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/LoopState"},"2621":{"id":"/docs/evsys_sdk/training/callbacks/LoopState-0","page_id":"/docs/evsys_sdk/training/callbacks/LoopState","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/LoopState#attributes","content":"Attributes"},"2622":{"id":"/docs/evsys_sdk/training/callbacks/LoopState-1","page_id":"/docs/evsys_sdk/training/callbacks/LoopState","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/LoopState#functions","content":"Functions"},"2623":{"id":"/docs/evsys_sdk/training/callbacks/LoopState-2","page_id":"/docs/evsys_sdk/training/callbacks/LoopState","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/LoopState","content":"Live training-loop context handed to every callback hook."},"2624":{"id":"/docs/evsys_sdk/training/callbacks/LoopState-3","page_id":"/docs/evsys_sdk/training/callbacks/LoopState","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/LoopState","content":"The fields are mutated in-place by the loop as the run progresses;\n`step` advances every iteration, `stop_requested` flips when a\ncallback calls :meth:`request_stop`. Other fields are immutable for\nthe run's lifetime."},"2625":{"id":"/docs/evsys_sdk/training/callbacks/LoopState-4","page_id":"/docs/evsys_sdk/training/callbacks/LoopState","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/LoopState#attributes","content":"Current step index (0-based). Advances per iteration."},"2626":{"id":"/docs/evsys_sdk/training/callbacks/LoopState-5","page_id":"/docs/evsys_sdk/training/callbacks/LoopState","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/LoopState#attributes","content":"The same log\\_store the loop writes to. Callbacks can also write\nauxiliary rows (e.g. `log_metrics(\\{\"debug/x\": 1\\}, step=...)`)."},"2627":{"id":"/docs/evsys_sdk/training/callbacks/LoopState-6","page_id":"/docs/evsys_sdk/training/callbacks/LoopState","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/LoopState#attributes","content":"The experiment-wide :class:`LogContext` (shared with the Experiment-scope\nhooks). `None` for a bare `run_experiment` with no Experiment driving it;\npopulated when the Experiment threads callbacks into the loop."},"2628":{"id":"/docs/evsys_sdk/training/callbacks/LoopState-7","page_id":"/docs/evsys_sdk/training/callbacks/LoopState","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/LoopState#functions","content":"Signal the loop to break after the current step completes."},"2629":{"id":"/docs/evsys_sdk/training/callbacks/LoopState-8","page_id":"/docs/evsys_sdk/training/callbacks/LoopState","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/LoopState#functions","content":"Used by EarlyStoppingCallback and similar policies. The loop honours\nit at the top of the next iteration so the current step's writes\nflush cleanly first."},"2630":{"id":"/docs/evsys_sdk/training/callbacks/PrintProgressCallback","page_id":"/docs/evsys_sdk/training/callbacks/PrintProgressCallback","type":"page","content":"PrintProgressCallback","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/PrintProgressCallback"},"2631":{"id":"/docs/evsys_sdk/training/callbacks/PrintProgressCallback-0","page_id":"/docs/evsys_sdk/training/callbacks/PrintProgressCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/PrintProgressCallback#attributes","content":"Attributes"},"2632":{"id":"/docs/evsys_sdk/training/callbacks/PrintProgressCallback-1","page_id":"/docs/evsys_sdk/training/callbacks/PrintProgressCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/PrintProgressCallback#functions","content":"Functions"},"2633":{"id":"/docs/evsys_sdk/training/callbacks/PrintProgressCallback-2","page_id":"/docs/evsys_sdk/training/callbacks/PrintProgressCallback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/PrintProgressCallback","content":"Compact one-liner per step to stdout. Useful when you're not on a\ndashboard."},"2634":{"id":"/docs/evsys_sdk/training/callbacks/PrintProgressConfig","page_id":"/docs/evsys_sdk/training/callbacks/PrintProgressConfig","type":"page","content":"PrintProgressConfig","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/PrintProgressConfig"},"2635":{"id":"/docs/evsys_sdk/training/callbacks/PrintProgressConfig-0","page_id":"/docs/evsys_sdk/training/callbacks/PrintProgressConfig","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/PrintProgressConfig#attributes","content":"Attributes"},"2636":{"id":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback","page_id":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback","type":"page","content":"TensorBoardLoggerCallback","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback"},"2637":{"id":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback-0","page_id":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback#attributes","content":"Attributes"},"2638":{"id":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback-1","page_id":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback#functions","content":"Functions"},"2639":{"id":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback-2","page_id":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback","content":"Log scalar metrics + eval scalars to TensorBoard, one event dir per arm."},"2640":{"id":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback-3","page_id":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback","content":"Opens a `SummaryWriter` in `on_run_start` (lazy import so the callback\nregisters without torch installed) and closes it in `on_run_end`."},"2641":{"id":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerConfig","page_id":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerConfig","type":"page","content":"TensorBoardLoggerConfig","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerConfig"},"2642":{"id":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerConfig-0","page_id":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerConfig","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/TensorBoardLoggerConfig#attributes","content":"Attributes"},"2643":{"id":"/docs/evsys_sdk/training/callbacks/WandbLoggerCallback","page_id":"/docs/evsys_sdk/training/callbacks/WandbLoggerCallback","type":"page","content":"WandbLoggerCallback","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/WandbLoggerCallback"},"2644":{"id":"/docs/evsys_sdk/training/callbacks/WandbLoggerCallback-0","page_id":"/docs/evsys_sdk/training/callbacks/WandbLoggerCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/WandbLoggerCallback#attributes","content":"Attributes"},"2645":{"id":"/docs/evsys_sdk/training/callbacks/WandbLoggerCallback-1","page_id":"/docs/evsys_sdk/training/callbacks/WandbLoggerCallback","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/WandbLoggerCallback#functions","content":"Functions"},"2646":{"id":"/docs/evsys_sdk/training/callbacks/WandbLoggerCallback-2","page_id":"/docs/evsys_sdk/training/callbacks/WandbLoggerCallback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/WandbLoggerCallback","content":"Log metrics + benchmark predictions to Weights & Biases."},"2647":{"id":"/docs/evsys_sdk/training/callbacks/WandbLoggerCallback-3","page_id":"/docs/evsys_sdk/training/callbacks/WandbLoggerCallback","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks/WandbLoggerCallback","content":"One W\\&B run per arm: opened in `on_run_start` (so it exists before the\nfirst step) and closed in `on_run_end`. wandb is imported lazily — if it\nisn't installed the callback warns once and every hook no-ops (training is\nnever affected; :func:`dispatch` also isolates errors). The run URL is\nsurfaced on `ctx.extras['wandb_url']` so a downstream logger\n(evsys\\_logger) can record it on the dashboard run."},"2648":{"id":"/docs/evsys_sdk/training/callbacks/WandbLoggerConfig","page_id":"/docs/evsys_sdk/training/callbacks/WandbLoggerConfig","type":"page","content":"WandbLoggerConfig","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks/WandbLoggerConfig"},"2649":{"id":"/docs/evsys_sdk/training/callbacks/WandbLoggerConfig-0","page_id":"/docs/evsys_sdk/training/callbacks/WandbLoggerConfig","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/callbacks/WandbLoggerConfig#attributes","content":"Attributes"},"2650":{"id":"/docs/evsys_sdk/training/callbacks","page_id":"/docs/evsys_sdk/training/callbacks","type":"page","content":"callbacks","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","callbacks"],"tags":[],"url":"/docs/evsys_sdk/training/callbacks"},"2651":{"id":"/docs/evsys_sdk/training/callbacks-0","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"Callbacks — hook points inside :class:`~evsys_sdk.training.loop.TrainingLoop`\nfor logging, debugging, visualization, and early stopping."},"2652":{"id":"/docs/evsys_sdk/training/callbacks-1","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"The :class:`Callback` base has no-op defaults for every hook. Override only\nthe ones you need:"},"2653":{"id":"/docs/evsys_sdk/training/callbacks-2","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"class MyDebug(Callback):\ndef on\\_step\\_end(self, state, step\\_idx, batch, metrics):\nif step\\_idx % 100 == 0:\nprint(f\"\\[\\{step\\_idx}] \\{metrics}\")"},"2654":{"id":"/docs/evsys_sdk/training/callbacks-3","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"Then hand to the loop:"},"2655":{"id":"/docs/evsys_sdk/training/callbacks-4","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"loop = TrainingLoop(..., callbacks=\\[MyDebug(), CsvMetricsCallback(...)])"},"2656":{"id":"/docs/evsys_sdk/training/callbacks-5","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"A failing callback never kills the loop — the exception is logged at\nWARNING and the loop continues. Same pattern as failing evaluators."},"2657":{"id":"/docs/evsys_sdk/training/callbacks-6","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"For early stopping (e.g. on a plateau in val pass\\_rate), call\n`state.request_stop()` from inside a hook and the loop breaks after the\ncurrent step. Researchers writing a new \"stop after N evals without\nimprovement\" policy subclass :class:`EarlyStoppingCallback`."},"2658":{"id":"/docs/evsys_sdk/training/callbacks-7","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"Three built-ins ship today:"},"2659":{"id":"/docs/evsys_sdk/training/callbacks-8","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":":class:`PrintProgressCallback` — tqdm-style stdout one-liner per step."},"2660":{"id":"/docs/evsys_sdk/training/callbacks-9","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":":class:`CsvMetricsCallback` — mirror metrics.jsonl to a per-step CSV for\npandas-friendly inspection."},"2661":{"id":"/docs/evsys_sdk/training/callbacks-10","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":":class:`EarlyStoppingCallback` — request\\_stop after N evals with no\nimprovement on a named metric."},"2662":{"id":"/docs/evsys_sdk/training/callbacks-11","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;LogContext&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/LogContext&#x22;\" />"},"2663":{"id":"/docs/evsys_sdk/training/callbacks-12","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;LoopState&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/LoopState&#x22;\" />"},"2664":{"id":"/docs/evsys_sdk/training/callbacks-13","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;Callback&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/Callback&#x22;\" />"},"2665":{"id":"/docs/evsys_sdk/training/callbacks-14","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;PrintProgressConfig&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/PrintProgressConfig&#x22;\" />"},"2666":{"id":"/docs/evsys_sdk/training/callbacks-15","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;PrintProgressCallback&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/PrintProgressCallback&#x22;\" />"},"2667":{"id":"/docs/evsys_sdk/training/callbacks-16","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;CsvMetricsConfig&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/CsvMetricsConfig&#x22;\" />"},"2668":{"id":"/docs/evsys_sdk/training/callbacks-17","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;CsvMetricsCallback&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/CsvMetricsCallback&#x22;\" />"},"2669":{"id":"/docs/evsys_sdk/training/callbacks-18","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;EarlyStoppingConfig&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/EarlyStoppingConfig&#x22;\" />"},"2670":{"id":"/docs/evsys_sdk/training/callbacks-19","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;EarlyStoppingCallback&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/EarlyStoppingCallback&#x22;\" />"},"2671":{"id":"/docs/evsys_sdk/training/callbacks-20","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;WandbLoggerConfig&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/WandbLoggerConfig&#x22;\" />"},"2672":{"id":"/docs/evsys_sdk/training/callbacks-21","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;WandbLoggerCallback&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/WandbLoggerCallback&#x22;\" />"},"2673":{"id":"/docs/evsys_sdk/training/callbacks-22","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;TensorBoardLoggerConfig&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/TensorBoardLoggerConfig&#x22;\" />"},"2674":{"id":"/docs/evsys_sdk/training/callbacks-23","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;TensorBoardLoggerCallback&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/TensorBoardLoggerCallback&#x22;\" />"},"2675":{"id":"/docs/evsys_sdk/training/callbacks-24","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;LocalLoggerConfig&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/LocalLoggerConfig&#x22;\" />"},"2676":{"id":"/docs/evsys_sdk/training/callbacks-25","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;LocalLoggerCallback&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/LocalLoggerCallback&#x22;\" />"},"2677":{"id":"/docs/evsys_sdk/training/callbacks-26","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;EvsysLoggerConfig&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/EvsysLoggerConfig&#x22;\" />"},"2678":{"id":"/docs/evsys_sdk/training/callbacks-27","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;EvsysLoggerCallback&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/EvsysLoggerCallback&#x22;\" />"},"2679":{"id":"/docs/evsys_sdk/training/callbacks-28","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;DebugLoggerConfig&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/DebugLoggerConfig&#x22;\" />"},"2680":{"id":"/docs/evsys_sdk/training/callbacks-29","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"<Card title=\"&#x22;DebugLoggerCallback&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/callbacks/DebugLoggerCallback&#x22;\" />"},"2681":{"id":"/docs/evsys_sdk/training/callbacks-30","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"Call `hook` on every callback. A raising callback NEVER propagates —\nthe exception is logged at WARNING and the next callback runs. Used by both\nthe TrainingLoop (loop-scope hooks) and the Experiment (experiment-scope\nhooks) so error isolation is identical everywhere."},"2682":{"id":"/docs/evsys_sdk/training/callbacks-31","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"Materialize callbacks from a list of `\\{kind, params\\}` specs."},"2683":{"id":"/docs/evsys_sdk/training/callbacks-32","page_id":"/docs/evsys_sdk/training/callbacks","tags":[],"type":"text","url":"/docs/evsys_sdk/training/callbacks","content":"Each `spec` may be a :class:`~evsys_sdk.config.CallbackSpec` (or any\nobject/dict with `kind` + `params`). The `kind` is resolved through\nthe callback registry; `params` are validated against the callback's\n`Config` (so a YAML typo fails loudly) before construction. Users\nregister their own callbacks with `@register_callback(\"my_name\")` — see\nthe built-ins above for the contract (`name` + `Config` ClassVars)."},"2684":{"id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","page_id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","type":"page","content":"CheckpointManager","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","checkpoints"],"tags":[],"url":"/docs/evsys_sdk/training/checkpoints/CheckpointManager"},"2685":{"id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager-0","page_id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/checkpoints/CheckpointManager#attributes","content":"Attributes"},"2686":{"id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager-1","page_id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/checkpoints/CheckpointManager#functions","content":"Functions"},"2687":{"id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager-2","page_id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","content":"Decide WHEN to save and WRITE the manifest row when we do."},"2688":{"id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager-3","page_id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","content":"The decision policy is intentionally tiny — `should_save(step)` returns\nTrue every `save_every` steps (after the optimizer step at that index).\nThe actual save call is dispatched by the loop, which has the live\n`Backend` handle; the manager only records the resulting paths."},"2689":{"id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager-4","page_id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","content":"Final-step save is unconditional: the loop calls `save_final(...)` after\nits for-loop completes, so even when `save_every` doesn't land exactly\non the last step the final sampler is always recorded — that's the URI\ndownstream eval consumes."},"2690":{"id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager-5","page_id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints/CheckpointManager#functions","content":"Save after the optimizer step at index `step` (zero-based)."},"2691":{"id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager-6","page_id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints/CheckpointManager#functions","content":"The convention matches tinker\\_cookbook: `(step + 1) % save_every == 0`.\nDisabled when `save_every == 0`."},"2692":{"id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager-7","page_id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints/CheckpointManager#functions","content":"Append one row to the manifest on disk and remember it."},"2693":{"id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager-8","page_id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints/CheckpointManager#functions","content":"Find the most-recent recorded checkpoint to resume training from."},"2694":{"id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager-9","page_id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints/CheckpointManager#functions","content":"Reads the existing `checkpoints.jsonl` (if any) under `log_path` and\npicks the last row that has a `state_path`. The loop hands the\nstate\\_path back to the backend to recreate the training client with\noptimizer state intact."},"2695":{"id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager-10","page_id":"/docs/evsys_sdk/training/checkpoints/CheckpointManager","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints/CheckpointManager#functions","content":"Returns `None` when no resumable checkpoint is on disk — caller\nshould start fresh."},"2696":{"id":"/docs/evsys_sdk/training/checkpoints/ManifestRow","page_id":"/docs/evsys_sdk/training/checkpoints/ManifestRow","type":"page","content":"ManifestRow","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","checkpoints"],"tags":[],"url":"/docs/evsys_sdk/training/checkpoints/ManifestRow"},"2697":{"id":"/docs/evsys_sdk/training/checkpoints/ManifestRow-0","page_id":"/docs/evsys_sdk/training/checkpoints/ManifestRow","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/checkpoints/ManifestRow#attributes","content":"Attributes"},"2698":{"id":"/docs/evsys_sdk/training/checkpoints/ManifestRow-1","page_id":"/docs/evsys_sdk/training/checkpoints/ManifestRow","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/checkpoints/ManifestRow#functions","content":"Functions"},"2699":{"id":"/docs/evsys_sdk/training/checkpoints","page_id":"/docs/evsys_sdk/training/checkpoints","type":"page","content":"checkpoints","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","checkpoints"],"tags":[],"url":"/docs/evsys_sdk/training/checkpoints"},"2700":{"id":"/docs/evsys_sdk/training/checkpoints-0","page_id":"/docs/evsys_sdk/training/checkpoints","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints","content":"CheckpointManager — write the `checkpoints.jsonl` manifest that\n:mod:`evsys_sdk.checkpoint` already knows how to read."},"2701":{"id":"/docs/evsys_sdk/training/checkpoints-1","page_id":"/docs/evsys_sdk/training/checkpoints","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints","content":"The reader half lives in `evsys_sdk/checkpoint.py`\n(:func:`~evsys_sdk.checkpoint.read_manifest`,\n:meth:`~evsys_sdk.checkpoint.Checkpoint.pick_final`). This is the writer\ncounterpart used by :class:`~evsys_sdk.training.loop.TrainingLoop`."},"2702":{"id":"/docs/evsys_sdk/training/checkpoints-2","page_id":"/docs/evsys_sdk/training/checkpoints","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints","content":"The format is intentionally identical to the manifest tinker\\_cookbook used\nto emit, so downstream consumers (e.g.\n:meth:`~evsys_sdk.inference.tinker.TinkerInference.from_run_result`) keep\nworking unchanged when an algorithm is ported to the native loop."},"2703":{"id":"/docs/evsys_sdk/training/checkpoints-3","page_id":"/docs/evsys_sdk/training/checkpoints","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints","content":"Schema per row (one JSON object per line)::"},"2704":{"id":"/docs/evsys_sdk/training/checkpoints-4","page_id":"/docs/evsys_sdk/training/checkpoints","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints","content":"\\{\"name\": \"step\\_500\", \"batch\": 499, \"epoch\": 3,\n\"state\\_path\": \"tinker://.../weights/step\\_500\",\n\"sampler\\_path\": \"tinker://.../sampler\\_weights/step\\_500\"}"},"2705":{"id":"/docs/evsys_sdk/training/checkpoints-5","page_id":"/docs/evsys_sdk/training/checkpoints","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints","content":"`state_path` is the full training state (weights + optimizer) used for\nresume. `sampler_path` is the inference-ready weights snapshot used by\nthe eval client."},"2706":{"id":"/docs/evsys_sdk/training/checkpoints-6","page_id":"/docs/evsys_sdk/training/checkpoints","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints","content":"<Card title=\"&#x22;ManifestRow&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/checkpoints/ManifestRow&#x22;\" />"},"2707":{"id":"/docs/evsys_sdk/training/checkpoints-7","page_id":"/docs/evsys_sdk/training/checkpoints","tags":[],"type":"text","url":"/docs/evsys_sdk/training/checkpoints","content":"<Card title=\"&#x22;CheckpointManager&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/checkpoints/CheckpointManager&#x22;\" />"},"2708":{"id":"/docs/evsys_sdk/training/data_processing/DatumMetadata","page_id":"/docs/evsys_sdk/training/data_processing/DatumMetadata","type":"page","content":"DatumMetadata","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","data_processing"],"tags":[],"url":"/docs/evsys_sdk/training/data_processing/DatumMetadata"},"2709":{"id":"/docs/evsys_sdk/training/data_processing/DatumMetadata-0","page_id":"/docs/evsys_sdk/training/data_processing/DatumMetadata","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/data_processing/DatumMetadata#attributes","content":"Attributes"},"2710":{"id":"/docs/evsys_sdk/training/data_processing/DatumMetadata-1","page_id":"/docs/evsys_sdk/training/data_processing/DatumMetadata","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/data_processing/DatumMetadata#functions","content":"Functions"},"2711":{"id":"/docs/evsys_sdk/training/data_processing/DatumMetadata-2","page_id":"/docs/evsys_sdk/training/data_processing/DatumMetadata","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing/DatumMetadata","content":"Per-Datum routing info kept on the side (not in the Datum itself —\ntinker rejects unknown keys in loss\\_fn\\_inputs)."},"2712":{"id":"/docs/evsys_sdk/training/data_processing/DatumMetadata-3","page_id":"/docs/evsys_sdk/training/data_processing/DatumMetadata","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing/DatumMetadata#attributes","content":"Index into the original `trajectory_groups` list — used for SDFT\nteacher-prompt lookup."},"2713":{"id":"/docs/evsys_sdk/training/data_processing","page_id":"/docs/evsys_sdk/training/data_processing","type":"page","content":"data_processing","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","data_processing"],"tags":[],"url":"/docs/evsys_sdk/training/data_processing"},"2714":{"id":"/docs/evsys_sdk/training/data_processing-0","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":"Turn :class:`~evsys_sdk.training.env.TrajectoryGroup`\\s into\n`list[tinker.Datum]` ready for IS-loss training."},"2715":{"id":"/docs/evsys_sdk/training/data_processing-1","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":"Port of `tinker_cookbook.rl.data_processing.compute_advantages` +\n`assemble_training_data`. Both are pure functions — no I/O, no\ntinker\\_cookbook dependency."},"2716":{"id":"/docs/evsys_sdk/training/data_processing-2","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":"The two-step pipeline:"},"2717":{"id":"/docs/evsys_sdk/training/data_processing-3","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":":func:`compute_advantages` — group-normalize rewards within each\n:class:`TrajectoryGroup` (subtract the group mean → reduces variance\nwithout bias)."},"2718":{"id":"/docs/evsys_sdk/training/data_processing-4","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":":func:`assemble_training_data` — flatten to a `list[tinker.Datum]`\nwith `loss_fn_inputs` = `target_tokens` + per-position `advantages`\n(0 off-completion → masks the loss) + `logprobs` from the sampler (the\n\"old\" logprobs for the IS ratio). These are the only keys tinker's\n`importance_sampling` loss accepts."},"2719":{"id":"/docs/evsys_sdk/training/data_processing-5","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":"<Card title=\"&#x22;DatumMetadata&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/data_processing/DatumMetadata&#x22;\" />"},"2720":{"id":"/docs/evsys_sdk/training/data_processing-6","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":"Return `advantages[group][traj]` — per-trajectory scalar advantages."},"2721":{"id":"/docs/evsys_sdk/training/data_processing-7","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":"`normalize=True` subtracts the group mean from each trajectory's reward\n(standard variance-reduction baseline). When a group has only one\ntrajectory, advantage = reward."},"2722":{"id":"/docs/evsys_sdk/training/data_processing-8","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":"Flatten `(group, trajectory, turn)` → `(Datum, DatumMetadata)` pairs."},"2723":{"id":"/docs/evsys_sdk/training/data_processing-9","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":"**One Datum per assistant turn** — a single-turn trajectory yields one\nDatum, a multi-turn one yields one per turn, all carrying the same\ntrajectory-level advantage. Each Datum carries:"},"2724":{"id":"/docs/evsys_sdk/training/data_processing-10","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":"`model_input`: turn prompt + completion\\[:-1] (left-shifted)."},"2725":{"id":"/docs/evsys_sdk/training/data_processing-11","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":"`loss_fn_inputs[\"target_tokens\"]`: the shifted next-token targets."},"2726":{"id":"/docs/evsys_sdk/training/data_processing-12","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":"`loss_fn_inputs[\"logprobs\"]`: sampler's per-position logprobs (zero on\nprompt positions). The \"old\" logprobs for the IS ratio."},"2727":{"id":"/docs/evsys_sdk/training/data_processing-13","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":"`loss_fn_inputs[\"advantages\"]`: the trajectory's group-normalized\nreward on completion positions; 0 on prompt positions — which is what\nmasks the loss to the completion (tinker's `importance_sampling` takes\nno mask/weights key, only target\\_tokens + logprobs + advantages)."},"2728":{"id":"/docs/evsys_sdk/training/data_processing-14","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":"Turns with no completion tokens are dropped silently — IS loss is a no-op."},"2729":{"id":"/docs/evsys_sdk/training/data_processing-15","page_id":"/docs/evsys_sdk/training/data_processing","tags":[],"type":"text","url":"/docs/evsys_sdk/training/data_processing","content":"Roll up group-level reward stats into a flat metrics dict."},"2730":{"id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","page_id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","type":"page","content":"BenchmarkEvaluator","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","evaluators"],"tags":[],"url":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator"},"2731":{"id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator-0","page_id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator#attributes","content":"Attributes"},"2732":{"id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator-1","page_id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator#functions","content":"Functions"},"2733":{"id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator-2","page_id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","content":"Score a :class:`~evsys_sdk.Benchmark` against the live sampler."},"2734":{"id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator-3","page_id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","content":"The :class:`~evsys_sdk.training.loop.TrainingLoop` checks\n`run_every` per evaluator (see :meth:`TrainingLoop._is_due`);\na value of `0` disables the evaluator (it never fires)."},"2735":{"id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator-4","page_id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","content":"`chat_template` mirrors the post-training eval spec\n(`system_prompt` + `user_template` + `enable_thinking`) so the\nsame YAML knob configures both the in-loop val and the final test set."},"2736":{"id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator-5","page_id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator#attributes","content":"Registered metric names to compute (harbor engine), e.g.\n`[\"pass@3\", \"pass^3\", \"avg\"]`. Empty → `mean_reward` + `pass_rate`."},"2737":{"id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator-6","page_id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator#attributes","content":"Cap the number of tasks scored per eval — useful when the benchmark\nis large and you want quick in-loop snapshots."},"2738":{"id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator-7","page_id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator#attributes","content":"`\"harbor\"` → score through harbor's rollout engine (off the eval\ncheckpoint). Anything else → the live-sampler InferenceClient path."},"2739":{"id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator-8","page_id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator#attributes","content":"Concurrent harbor trials (harbor engine only). Higher = more rollouts in\nflight against the sampler; all share one cached sampling client."},"2740":{"id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator-9","page_id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator#functions","content":"Score the validation benchmark through harbor (same engine as\ntraining); reward = each task's verifier. Returns the metric dict and,\nwhen `store` + `run_id` are set, uploads the eval rollouts."},"2741":{"id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator-10","page_id":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator#functions","content":"Record one `eval` (per step) + its per-task rollout predictions on\nthe dashboard. Best-effort: a dashboard hiccup must not kill training."},"2742":{"id":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler","page_id":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler","type":"page","content":"_AsyncToSyncSampler","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","evaluators"],"tags":[],"url":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler"},"2743":{"id":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler-0","page_id":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler#attributes","content":"Attributes"},"2744":{"id":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler-1","page_id":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler#functions","content":"Functions"},"2745":{"id":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler-2","page_id":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler","content":"Sync :class:`~evsys_sdk.protocols.InferenceClient` over an async\n:class:`~evsys_sdk.training.backend.SamplingClient`."},"2746":{"id":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler-3","page_id":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler","content":"`.generate(prompt=...)` is called sequentially by\n:meth:`Benchmark.score` from a worker thread; we route the awaited\n`sample_async` call back to the main event loop via\n:func:`asyncio.run_coroutine_threadsafe` so the inner async work\nruns on the loop that owns the live training client."},"2747":{"id":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler-4","page_id":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler","content":"Exposes `_tokenizer` so :class:`ChatTemplatedInference` can wrap\nthis client without further plumbing — same shape\n:class:`TinkerInference` exposes."},"2748":{"id":"/docs/evsys_sdk/training/evaluators","page_id":"/docs/evsys_sdk/training/evaluators","type":"page","content":"evaluators","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","evaluators"],"tags":[],"url":"/docs/evsys_sdk/training/evaluators"},"2749":{"id":"/docs/evsys_sdk/training/evaluators-0","page_id":"/docs/evsys_sdk/training/evaluators","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators","content":"In-loop evaluator adapters — wrap an :class:`evsys_sdk.Benchmark`\nso the training loop can score it every N steps against the live\nsampler."},"2750":{"id":"/docs/evsys_sdk/training/evaluators-1","page_id":"/docs/evsys_sdk/training/evaluators","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators","content":"The post-training scoring path (`Experiment._eval_arm` →\n`Benchmark.score(client)`) takes a *synchronous* `InferenceClient`.\nThe training-loop eval slot hands evaluators a live *async*\n`SamplingClient`. :class:`_AsyncToSyncSampler` bridges the two with\n`asyncio.run_coroutine_threadsafe` + `asyncio.to_thread` so the\nBenchmark iteration doesn't block the event loop and the existing\n`ChatTemplatedInference` wrapper (which inspects `_tokenizer`) keeps\nworking unchanged."},"2751":{"id":"/docs/evsys_sdk/training/evaluators-2","page_id":"/docs/evsys_sdk/training/evaluators","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators","content":"The other half of the wiring is :func:`build_in_loop_evaluators` — a\nmetadata-aware factory that the three native algorithm composers call to\nturn `metadata.benchmark` list entries with a `run_every` field into\n:class:`BenchmarkEvaluator` instances ready for the\n:class:`~evsys_sdk.training.loop.TrainingLoop` evaluators list."},"2752":{"id":"/docs/evsys_sdk/training/evaluators-3","page_id":"/docs/evsys_sdk/training/evaluators","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators","content":"<Card title=\"&#x22;_AsyncToSyncSampler&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/evaluators/_AsyncToSyncSampler&#x22;\" />"},"2753":{"id":"/docs/evsys_sdk/training/evaluators-4","page_id":"/docs/evsys_sdk/training/evaluators","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators","content":"<Card title=\"&#x22;BenchmarkEvaluator&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/evaluators/BenchmarkEvaluator&#x22;\" />"},"2754":{"id":"/docs/evsys_sdk/training/evaluators-5","page_id":"/docs/evsys_sdk/training/evaluators","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators","content":"Read `metadata.benchmark` and return one\n:class:`BenchmarkEvaluator` per entry whose `run_every` > 0."},"2755":{"id":"/docs/evsys_sdk/training/evaluators-6","page_id":"/docs/evsys_sdk/training/evaluators","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators","content":"Single-dict `benchmark` and list form are both accepted (matches the\nparser in :meth:`evsys_sdk.experiment.Experiment._resolve_benchmarks`).\nEntries without `run_every` are post-training-only and silently\nskipped here — they're handled by `Experiment._eval_arm`."},"2756":{"id":"/docs/evsys_sdk/training/evaluators-7","page_id":"/docs/evsys_sdk/training/evaluators","tags":[],"type":"text","url":"/docs/evsys_sdk/training/evaluators","content":"`tokenizer` is required (used by the async→sync sampler bridge);\n`store` is required when an entry resolves a benchmark by `id` or\n`name` rather than `path`."},"2757":{"id":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent","page_id":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent","type":"page","content":"BasicLoopAgent","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","harbor_agents"],"tags":[],"url":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent"},"2758":{"id":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent-0","page_id":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent#functions","content":"Functions"},"2759":{"id":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent-1","page_id":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent","content":"Drive `Chat(TinkerLLM(model_path))` and record the rollout: token-level\n`rollout_details` + the completion text on the `AgentContext`, and the\ncompletion written to the agent dir for the host-side verifier to score."},"2760":{"id":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent-2","page_id":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent#functions","content":"The harbor sampler for this rollout. `model_client` picks it:\n`\"tinker\"` → on-policy `TinkerLLM` (needs `model_path`);\n`\"litellm\"` → harbor's litellm LLM for any provider (`model_name` a\nlitellm string, e.g. `\"anthropic/claude-opus-4-1\"`; keys from the\nprovider env vars)."},"2761":{"id":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent-3","page_id":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent#functions","content":"`collect_rollout_details` is ON for tinker (we want token-level\nrollouts for training) but OFF for litellm: it makes harbor request\n`logprobs` + `extra_body.return_token_ids`, which closed APIs\n(Anthropic, OpenAI) reject with a 400. API-model benchmarking only needs\nthe completion + reward + usage (cost/tokens), not token ids — those are\nstill captured from the response. See `_trial_to_trajectory`."},"2762":{"id":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent-4","page_id":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent#functions","content":"The cached LLM for this rollout's (loop, config) — built once per\nharbor job and reused by every trial (see the module cache note). The\nfirst build is warmed under a per-loop lock so concurrent trials share\nONE sampling client instead of each creating their own."},"2763":{"id":"/docs/evsys_sdk/training/harbor_agents/EvsysVerifier","page_id":"/docs/evsys_sdk/training/harbor_agents/EvsysVerifier","type":"page","content":"EvsysVerifier","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","harbor_agents"],"tags":[],"url":"/docs/evsys_sdk/training/harbor_agents/EvsysVerifier"},"2764":{"id":"/docs/evsys_sdk/training/harbor_agents/EvsysVerifier-0","page_id":"/docs/evsys_sdk/training/harbor_agents/EvsysVerifier","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/harbor_agents/EvsysVerifier#functions","content":"Functions"},"2765":{"id":"/docs/evsys_sdk/training/harbor_agents/EvsysVerifier-1","page_id":"/docs/evsys_sdk/training/harbor_agents/EvsysVerifier","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_agents/EvsysVerifier","content":"Score the agent's completion with a registered evsys verifier fn —\nhost-side, no container exec. Reads the completion the agent wrote to its\nagent dir and the per-task spec (`fn_name`/`expected`/`params`)\nmaterialized into the task dir, and returns the reward as harbor's\n`VerifierResult`. Set as the job-level verifier (SHARED mode)."},"2766":{"id":"/docs/evsys_sdk/training/harbor_agents/NoOpEnvironment","page_id":"/docs/evsys_sdk/training/harbor_agents/NoOpEnvironment","type":"page","content":"NoOpEnvironment","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","harbor_agents"],"tags":[],"url":"/docs/evsys_sdk/training/harbor_agents/NoOpEnvironment"},"2767":{"id":"/docs/evsys_sdk/training/harbor_agents/NoOpEnvironment-0","page_id":"/docs/evsys_sdk/training/harbor_agents/NoOpEnvironment","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/harbor_agents/NoOpEnvironment#functions","content":"Functions"},"2768":{"id":"/docs/evsys_sdk/training/harbor_agents/NoOpEnvironment-1","page_id":"/docs/evsys_sdk/training/harbor_agents/NoOpEnvironment","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_agents/NoOpEnvironment","content":"Sandbox-free environment: every operation is a no-op (no container)."},"2769":{"id":"/docs/evsys_sdk/training/harbor_agents/NoOpEnvironment-2","page_id":"/docs/evsys_sdk/training/harbor_agents/NoOpEnvironment","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_agents/NoOpEnvironment","content":"Agents using this run in-process; there's nothing to upload/download, so the\nlog-sync steps harbor logs a warning for are harmless (the agent writes\ndirectly onto the `AgentContext`, which is harvested regardless)."},"2770":{"id":"/docs/evsys_sdk/training/harbor_agents","page_id":"/docs/evsys_sdk/training/harbor_agents","type":"page","content":"harbor_agents","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","harbor_agents"],"tags":[],"url":"/docs/evsys_sdk/training/harbor_agents"},"2771":{"id":"/docs/evsys_sdk/training/harbor_agents-0","page_id":"/docs/evsys_sdk/training/harbor_agents","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_agents","content":"Harbor glue classes — agent + environment (harbor 0.13.2)."},"2772":{"id":"/docs/evsys_sdk/training/harbor_agents-1","page_id":"/docs/evsys_sdk/training/harbor_agents","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_agents","content":"These subclass harbor base classes, so `harbor` is imported at module top.\nOur own code **never imports this module directly** — harbor loads these by the\nstring `import_path` recorded in the job/agent config at runtime (see\n:mod:`evsys_sdk.training.harbor_engine`). That keeps the optional `[harbor]`\nextra out of the base import path."},"2773":{"id":"/docs/evsys_sdk/training/harbor_agents-2","page_id":"/docs/evsys_sdk/training/harbor_agents","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_agents","content":":class:`NoOpEnvironment` — sandbox-free `BaseEnvironment` (no container)."},"2774":{"id":"/docs/evsys_sdk/training/harbor_agents-3","page_id":"/docs/evsys_sdk/training/harbor_agents","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_agents","content":":class:`BasicLoopAgent` — drives `Chat(\\<llm>)` on-policy, records token-level\n`rollout_details` onto the `AgentContext`, and writes the completion to the\nagent dir so the verifier can read it. The default agent. `model_client` picks\nthe sampler: `\"tinker\"` (on-policy `TinkerLLM`) or `\"litellm\"` (any provider\nlitellm supports, for benchmarking closed/API models through the same path).\nUsers can also plug any `BaseAgent` via `agent_import_path`."},"2775":{"id":"/docs/evsys_sdk/training/harbor_agents-4","page_id":"/docs/evsys_sdk/training/harbor_agents","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_agents","content":":class:`EvsysVerifier` — a harbor `BaseVerifier` that wraps our **registered\nverifier fns**. It runs host-side (no container exec): reads the completion the\nagent wrote + the per-task spec (`fn_name`/`expected`/`params`)\nmaterialized into the task dir, and returns the reward as a harbor\n`VerifierResult`. Used in SHARED mode (a dummy `tests/test.sh`, written by\nthe materializer, satisfies harbor's task-load check and is never executed)."},"2776":{"id":"/docs/evsys_sdk/training/harbor_agents-5","page_id":"/docs/evsys_sdk/training/harbor_agents","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_agents","content":"<Card title=\"&#x22;NoOpEnvironment&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/harbor_agents/NoOpEnvironment&#x22;\" />"},"2777":{"id":"/docs/evsys_sdk/training/harbor_agents-6","page_id":"/docs/evsys_sdk/training/harbor_agents","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_agents","content":"<Card title=\"&#x22;BasicLoopAgent&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/harbor_agents/BasicLoopAgent&#x22;\" />"},"2778":{"id":"/docs/evsys_sdk/training/harbor_agents-7","page_id":"/docs/evsys_sdk/training/harbor_agents","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_agents","content":"<Card title=\"&#x22;EvsysVerifier&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/harbor_agents/EvsysVerifier&#x22;\" />"},"2779":{"id":"/docs/evsys_sdk/training/harbor_engine/HarborTaskAdapter","page_id":"/docs/evsys_sdk/training/harbor_engine/HarborTaskAdapter","type":"page","content":"HarborTaskAdapter","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","harbor_engine"],"tags":[],"url":"/docs/evsys_sdk/training/harbor_engine/HarborTaskAdapter"},"2780":{"id":"/docs/evsys_sdk/training/harbor_engine/HarborTaskAdapter-0","page_id":"/docs/evsys_sdk/training/harbor_engine/HarborTaskAdapter","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/harbor_engine/HarborTaskAdapter#functions","content":"Functions"},"2781":{"id":"/docs/evsys_sdk/training/harbor_engine/HarborTaskAdapter-1","page_id":"/docs/evsys_sdk/training/harbor_engine/HarborTaskAdapter","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine/HarborTaskAdapter","content":"Adapt our `HarborTask` rows (the `harbor_task` / RL + eval format) to\nharbor task dirs + native `TaskConfig`\\s — **scored** rollouts."},"2782":{"id":"/docs/evsys_sdk/training/harbor_engine/HarborTaskAdapter-2","page_id":"/docs/evsys_sdk/training/harbor_engine/HarborTaskAdapter","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine/HarborTaskAdapter","content":"`to_harbor(output_dir)` writes one task dir per task (`instruction.md` +\na SHARED-mode `task.toml` + a dummy `tests/test.sh` that only satisfies\nharbor's load check + the per-task `evsys_verifier.json` spec our host-side\n:class:`~evsys_sdk.training.harbor_agents.EvsysVerifier` reads) and returns\nthe `TaskConfig`\\s pointing at them. Requires an `InProcessVerifier`.\nUsed by `run_harbor_rollouts(..., outcome_reward=True)` (RL + benchmark eval)."},"2783":{"id":"/docs/evsys_sdk/training/harbor_engine/PromptAdapter","page_id":"/docs/evsys_sdk/training/harbor_engine/PromptAdapter","type":"page","content":"PromptAdapter","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","harbor_engine"],"tags":[],"url":"/docs/evsys_sdk/training/harbor_engine/PromptAdapter"},"2784":{"id":"/docs/evsys_sdk/training/harbor_engine/PromptAdapter-0","page_id":"/docs/evsys_sdk/training/harbor_engine/PromptAdapter","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/harbor_engine/PromptAdapter#functions","content":"Functions"},"2785":{"id":"/docs/evsys_sdk/training/harbor_engine/PromptAdapter-1","page_id":"/docs/evsys_sdk/training/harbor_engine/PromptAdapter","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine/PromptAdapter","content":"Adapt raw prompts (the generation / \"prompt\" format) to harbor task dirs +\nnative `TaskConfig`\\s — **generation-only** rollouts (no verifier, no\nreward). Used by SDFT student rollouts."},"2786":{"id":"/docs/evsys_sdk/training/harbor_engine/PromptAdapter-2","page_id":"/docs/evsys_sdk/training/harbor_engine/PromptAdapter","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine/PromptAdapter","content":"`to_harbor(output_dir)` writes `instruction.md` + a verifier-less\n`task.toml` (`environment_mode=\"separate\"` skips the test.sh load check)\nper prompt and returns the `TaskConfig`\\s. Used by\n`run_harbor_rollouts(..., outcome_reward=False)` (SDFT student rollouts)."},"2787":{"id":"/docs/evsys_sdk/training/harbor_engine","page_id":"/docs/evsys_sdk/training/harbor_engine","type":"page","content":"harbor_engine","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","harbor_engine"],"tags":[],"url":"/docs/evsys_sdk/training/harbor_engine"},"2788":{"id":"/docs/evsys_sdk/training/harbor_engine-0","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"Harbor rollout runner — hands rollouts to harbor's `Job` engine (0.13.2)."},"2789":{"id":"/docs/evsys_sdk/training/harbor_engine-1","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"Import-safe **without** the `harbor` package: all harbor imports are lazy\n(inside the runners), and the agent / environment classes are referenced only by\n**string import path** (they live in :mod:`evsys_sdk.training.harbor_agents`,\nwhich harbor loads at trial runtime). So `rl` / `sdft` can import this\nmodule, and tests can mock the runners, with no `harbor` install."},"2790":{"id":"/docs/evsys_sdk/training/harbor_engine-2","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"Flow (harbor 0.13.2): a producer's **adapter** (:class:`HarborTaskAdapter` for\nscored rollouts, :class:`PromptAdapter` for generation) writes each task dir\n(`instruction.md` + `task.toml` \\[+ `evsys_verifier.json` spec + a dummy\n`tests/test.sh` when scored]) and returns harbor-native `TaskConfig`\\s →\n:func:`run_harbor_rollouts` builds a `JobConfig` over those `TaskConfig`\\s ×\none `agent`, `n_attempts = num_samples` → `Job.run()` → harvest each\ntrial's `agent_result` (`rollout_details` + completion + token/cost usage)\nand `verifier_result` (reward) into a :class:`Trajectory`."},"2791":{"id":"/docs/evsys_sdk/training/harbor_engine-3","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"The reward is produced by harbor running our\n:class:`~evsys_sdk.training.harbor_agents.EvsysVerifier` (the job-level verifier)\n**host-side, no container**: it wraps the task's registered verifier fn over the\ncompletion the agent wrote. SHARED verifier mode (the default) keeps it in the\nagent's no-op environment; the dummy `tests/test.sh` only satisfies harbor's\ntask-load check and is never executed. (Generation-only rollouts disable the\nverifier and use `environment_mode=\"separate\"` so no `test.sh` is needed.)"},"2792":{"id":"/docs/evsys_sdk/training/harbor_engine-4","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"<Card title=\"&#x22;HarborTaskAdapter&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/harbor_engine/HarborTaskAdapter&#x22;\" />"},"2793":{"id":"/docs/evsys_sdk/training/harbor_engine-5","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"<Card title=\"&#x22;PromptAdapter&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/harbor_engine/PromptAdapter&#x22;\" />"},"2794":{"id":"/docs/evsys_sdk/training/harbor_engine-6","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"Pick the harbor agent + its kwargs for a rollout. Pure + harbor-free so\nthe agent-selection logic is unit-testable."},"2795":{"id":"/docs/evsys_sdk/training/harbor_engine-7","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"An explicit `agent_import_path` wins (fully self-configured agent, no\nkwargs). Otherwise it's always :class:`BasicLoopAgent`, parameterized by\n`model_client`: `\"tinker\"` (on-policy `TinkerLLM`, needs `model_path`)\nor `\"litellm\"` (closed/API model; `model_name` is a litellm string, the\ntinker-only `model_path`/`renderer_name` are ignored)."},"2796":{"id":"/docs/evsys_sdk/training/harbor_engine-8","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"Map `(import_path, agent kwargs)` → a harbor `AgentConfig`."},"2797":{"id":"/docs/evsys_sdk/training/harbor_engine-9","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"harbor 0.13.2 passes `model_name` to the agent constructor from the\ntop-level `AgentConfig.model_name` field, so it must NOT also live in\n`kwargs` (else the agent gets `model_name` twice). Lift it out here so\nthe agent-selection logic above can stay a flat kwargs dict."},"2798":{"id":"/docs/evsys_sdk/training/harbor_engine-10","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"Roll out `items` (× `num_samples`) through harbor's `Job` engine —\none :class:`TrajectoryGroup` per item, in order."},"2799":{"id":"/docs/evsys_sdk/training/harbor_engine-11","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"`outcome_reward` is the agent-meaningful knob — does the rollout get scored\nby an outcome verifier? The runner is adapter-aware (it runs the matching\nadapter to write the task dirs, where `materialize_task` used to be), so no\ncaller ever touches an adapter:"},"2800":{"id":"/docs/evsys_sdk/training/harbor_engine-12","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"`outcome_reward=True` (default) — `items` are :class:`HarborTask`\\s;\n:class:`HarborTaskAdapter` writes scored task dirs and the host-side\n:class:`EvsysVerifier` produces each outcome reward. (RL + benchmark eval.)"},"2801":{"id":"/docs/evsys_sdk/training/harbor_engine-13","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"`outcome_reward=False` — `items` are prompt strings; :class:`PromptAdapter`\nwrites generation-only dirs (no verifier, `reward=0`). (SDFT students.)"},"2802":{"id":"/docs/evsys_sdk/training/harbor_engine-14","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"`model_client` — `\"tinker\"` (on-policy `TinkerLLM`, needs `model_path`)\nor `\"litellm\"` (closed/API model; `model_name` a litellm string, e.g.\n`\"anthropic/claude-opus-4-1\"`)."},"2803":{"id":"/docs/evsys_sdk/training/harbor_engine-15","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"`_job_factory` is the test seam: `async (job_config) -> job_result`.\nWhen `None`, harbor is imported and `Job.create(...).run()` is used."},"2804":{"id":"/docs/evsys_sdk/training/harbor_engine-16","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"Group a job's trial results by `task_name` (the materialized dir's\nbasename = `_safe(task_id)`). `n_attempts` trials share a task\\_name."},"2805":{"id":"/docs/evsys_sdk/training/harbor_engine-17","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"Convert a harbor `TrialResult` → our multi-turn :class:`Trajectory`,\nreading the rollout off `agent_result` (`AgentContext`)."},"2806":{"id":"/docs/evsys_sdk/training/harbor_engine-18","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"Token-level turns come from `rollout_details` (tinker on-policy rollouts).\nClosed/API models (litellm) return no token ids, so for an eval trial — one\nthat produced a verifier reward — we still build a *token-less* Trajectory\ncarrying the reward + usage so it isn't dropped from scoring. Errored trials,\nand generation-only trials with neither tokens nor a reward, return `None`."},"2807":{"id":"/docs/evsys_sdk/training/harbor_engine-19","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"Pull harbor's native cost / token / timing info off a trial result."},"2808":{"id":"/docs/evsys_sdk/training/harbor_engine-20","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"Harbor records `cost_usd` + token counts on `agent_result`\n(`AgentContext`) and per-phase wall-clock timing on the trial\n(`agent_execution`, whole-trial span as fallback). Any field harbor didn't\npopulate stays `None` — on-policy tinker has no API `cost_usd`, and the\ncaller backfills token counts from the turns. Pure + harbor-free."},"2809":{"id":"/docs/evsys_sdk/training/harbor_engine-21","page_id":"/docs/evsys_sdk/training/harbor_engine","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_engine","content":"Wall-clock seconds for a harbor timing phase — anything carrying\n`started_at` / `finished_at` datetimes. `None` when either is missing."},"2810":{"id":"/docs/evsys_sdk/training/loop/Evaluator","page_id":"/docs/evsys_sdk/training/loop/Evaluator","type":"page","content":"Evaluator","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","loop"],"tags":[],"url":"/docs/evsys_sdk/training/loop/Evaluator"},"2811":{"id":"/docs/evsys_sdk/training/loop/Evaluator-0","page_id":"/docs/evsys_sdk/training/loop/Evaluator","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/loop/Evaluator#attributes","content":"Attributes"},"2812":{"id":"/docs/evsys_sdk/training/loop/Evaluator-1","page_id":"/docs/evsys_sdk/training/loop/Evaluator","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/loop/Evaluator#functions","content":"Functions"},"2813":{"id":"/docs/evsys_sdk/training/loop/Evaluator-2","page_id":"/docs/evsys_sdk/training/loop/Evaluator","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/Evaluator","content":"Periodic in-loop evaluator."},"2814":{"id":"/docs/evsys_sdk/training/loop/Evaluator-3","page_id":"/docs/evsys_sdk/training/loop/Evaluator","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/Evaluator","content":"Each evaluator owns one metric source (a Benchmark, a custom probe,\netc.) and carries its own `run_every` cadence. This lets a single\ntraining run mix a fast val benchmark (`run_every: 50`) with a\nheavier test benchmark (`run_every: 500`)."},"2815":{"id":"/docs/evsys_sdk/training/loop/Evaluator-4","page_id":"/docs/evsys_sdk/training/loop/Evaluator","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/Evaluator#attributes","content":"Short name; used to prefix the metric keys (`val/\\<name>/\\<key>`)."},"2816":{"id":"/docs/evsys_sdk/training/loop/Evaluator-5","page_id":"/docs/evsys_sdk/training/loop/Evaluator","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/Evaluator#attributes","content":"Per-evaluator step cadence. `0` → disabled (never fires).\nPositive → fire when `(step + 1) % run_every == 0`."},"2817":{"id":"/docs/evsys_sdk/training/loop/LoopArtifacts","page_id":"/docs/evsys_sdk/training/loop/LoopArtifacts","type":"page","content":"LoopArtifacts","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","loop"],"tags":[],"url":"/docs/evsys_sdk/training/loop/LoopArtifacts"},"2818":{"id":"/docs/evsys_sdk/training/loop/LoopArtifacts-0","page_id":"/docs/evsys_sdk/training/loop/LoopArtifacts","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/loop/LoopArtifacts#attributes","content":"Attributes"},"2819":{"id":"/docs/evsys_sdk/training/loop/LoopArtifacts-1","page_id":"/docs/evsys_sdk/training/loop/LoopArtifacts","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/loop/LoopArtifacts#functions","content":"Functions"},"2820":{"id":"/docs/evsys_sdk/training/loop/LoopArtifacts-2","page_id":"/docs/evsys_sdk/training/loop/LoopArtifacts","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/LoopArtifacts","content":"Per-run filesystem + state pointers, used to populate `RunResult`."},"2821":{"id":"/docs/evsys_sdk/training/loop/LoopArtifacts-3","page_id":"/docs/evsys_sdk/training/loop/LoopArtifacts","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/LoopArtifacts#attributes","content":"The output directory written to. Algorithms surface this as\n`RunResult.artifacts[\"run_dir\"]` for downstream consumers\n(e.g. `TinkerInference.from_run_result`)."},"2822":{"id":"/docs/evsys_sdk/training/loop/LoopArtifacts-4","page_id":"/docs/evsys_sdk/training/loop/LoopArtifacts","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/LoopArtifacts#attributes","content":"Path to the `checkpoints.jsonl` the loop wrote."},"2823":{"id":"/docs/evsys_sdk/training/loop/LoopArtifacts-5","page_id":"/docs/evsys_sdk/training/loop/LoopArtifacts","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/LoopArtifacts#attributes","content":"Manifest rows the loop wrote, in order. The last one is the\nfinal sampler — the URI eval consumes."},"2824":{"id":"/docs/evsys_sdk/training/loop/LoopArtifacts-6","page_id":"/docs/evsys_sdk/training/loop/LoopArtifacts","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/LoopArtifacts#attributes","content":"The step horizon passed to :meth:`TrainingLoop.run` (`num_steps`) —\nNOT the number of steps actually executed. These differ when a callback\nearly-stops the loop via `state.request_stop()`: this field still reads\nthe requested ceiling. For \"how many steps actually ran\", read\n`state.step + 1` inside `on_train_end` (`state.step` is the last\nexecuted index)."},"2825":{"id":"/docs/evsys_sdk/training/loop/LoopArtifacts-7","page_id":"/docs/evsys_sdk/training/loop/LoopArtifacts","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/LoopArtifacts#functions","content":"Flatten to the `RunResult.artifacts` shape that downstream\nconsumers (e.g. `TinkerInference.from_run_result`) read."},"2826":{"id":"/docs/evsys_sdk/training/loop/StepBuilder","page_id":"/docs/evsys_sdk/training/loop/StepBuilder","type":"page","content":"StepBuilder","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","loop"],"tags":[],"url":"/docs/evsys_sdk/training/loop/StepBuilder"},"2827":{"id":"/docs/evsys_sdk/training/loop/StepBuilder-0","page_id":"/docs/evsys_sdk/training/loop/StepBuilder","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/loop/StepBuilder#functions","content":"Functions"},"2828":{"id":"/docs/evsys_sdk/training/loop/StepBuilder-1","page_id":"/docs/evsys_sdk/training/loop/StepBuilder","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/StepBuilder","content":"The only thing each algorithm overrides."},"2829":{"id":"/docs/evsys_sdk/training/loop/StepBuilder-2","page_id":"/docs/evsys_sdk/training/loop/StepBuilder","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/StepBuilder","content":"Owns data shaping + per-step metrics. Owns nothing about\ncheckpointing / logging / eval / resume."},"2830":{"id":"/docs/evsys_sdk/training/loop/StepBuilder-3","page_id":"/docs/evsys_sdk/training/loop/StepBuilder","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/StepBuilder#functions","content":"Produce the batch for `step_idx` (0-based)."},"2831":{"id":"/docs/evsys_sdk/training/loop/StepBuilder-4","page_id":"/docs/evsys_sdk/training/loop/StepBuilder","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/StepBuilder#functions","content":"Compute per-step metrics from the forward-backward result."},"2832":{"id":"/docs/evsys_sdk/training/loop/StepBuilder-5","page_id":"/docs/evsys_sdk/training/loop/StepBuilder","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/StepBuilder#functions","content":"`fb_result` is what the backend's\n`forward_backward_*_async()` future resolved to. For\n`MockBackend` it's a duck-typed\n:class:`~evsys_sdk.training.backend.ForwardBackwardResult`; for\n`TinkerBackend` it's the native `tinker.ForwardBackwardOutput`.\nThe StepBuilder is free to inspect `fb_result.loss_fn_outputs`\n(one entry per Datum)."},"2833":{"id":"/docs/evsys_sdk/training/loop/TrainingBatch","page_id":"/docs/evsys_sdk/training/loop/TrainingBatch","type":"page","content":"TrainingBatch","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","loop"],"tags":[],"url":"/docs/evsys_sdk/training/loop/TrainingBatch"},"2834":{"id":"/docs/evsys_sdk/training/loop/TrainingBatch-0","page_id":"/docs/evsys_sdk/training/loop/TrainingBatch","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/loop/TrainingBatch#attributes","content":"Attributes"},"2835":{"id":"/docs/evsys_sdk/training/loop/TrainingBatch-1","page_id":"/docs/evsys_sdk/training/loop/TrainingBatch","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/loop/TrainingBatch#functions","content":"Functions"},"2836":{"id":"/docs/evsys_sdk/training/loop/TrainingBatch-2","page_id":"/docs/evsys_sdk/training/loop/TrainingBatch","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/TrainingBatch","content":"One step's worth of training data + loss spec."},"2837":{"id":"/docs/evsys_sdk/training/loop/TrainingBatch-3","page_id":"/docs/evsys_sdk/training/loop/TrainingBatch","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/TrainingBatch","content":"Constructed by a :class:`StepBuilder` per step. The loop hands `data`\nto the backend along with `loss_fn` and `loss_fn_config`."},"2838":{"id":"/docs/evsys_sdk/training/loop/TrainingBatch-4","page_id":"/docs/evsys_sdk/training/loop/TrainingBatch","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/TrainingBatch#attributes","content":"Either a tinker-recognised string name (`\"cross_entropy\"` /\n`\"importance_sampling\"` / ...) for a server-side loss, OR a Python\ncallable for a client-side custom loss. The loop dispatches the right\nbackend method based on the type."},"2839":{"id":"/docs/evsys_sdk/training/loop/TrainingBatch-5","page_id":"/docs/evsys_sdk/training/loop/TrainingBatch","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/TrainingBatch#attributes","content":"Only used when `loss_fn` is a string."},"2840":{"id":"/docs/evsys_sdk/training/loop/TrainingBatch-6","page_id":"/docs/evsys_sdk/training/loop/TrainingBatch","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/TrainingBatch#attributes","content":"Algorithm-precomputed per-step metrics (e.g. teacher entropy,\nreward stats). Merged into the per-step log row."},"2841":{"id":"/docs/evsys_sdk/training/loop/TrainingLoop","page_id":"/docs/evsys_sdk/training/loop/TrainingLoop","type":"page","content":"TrainingLoop","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","loop"],"tags":[],"url":"/docs/evsys_sdk/training/loop/TrainingLoop"},"2842":{"id":"/docs/evsys_sdk/training/loop/TrainingLoop-0","page_id":"/docs/evsys_sdk/training/loop/TrainingLoop","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/loop/TrainingLoop#attributes","content":"Attributes"},"2843":{"id":"/docs/evsys_sdk/training/loop/TrainingLoop-1","page_id":"/docs/evsys_sdk/training/loop/TrainingLoop","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/loop/TrainingLoop#functions","content":"Functions"},"2844":{"id":"/docs/evsys_sdk/training/loop/TrainingLoop-2","page_id":"/docs/evsys_sdk/training/loop/TrainingLoop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/TrainingLoop","content":"Drive a training run against a :class:`Backend`."},"2845":{"id":"/docs/evsys_sdk/training/loop/TrainingLoop-3","page_id":"/docs/evsys_sdk/training/loop/TrainingLoop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/TrainingLoop","content":"Construction is intentionally explicit — no global state, no env-var\nknobs, no auto-resume. Algorithms compose the loop with their own\nStepBuilder + Backend + optional Evaluators."},"2846":{"id":"/docs/evsys_sdk/training/loop/TrainingLoop-4","page_id":"/docs/evsys_sdk/training/loop/TrainingLoop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/TrainingLoop#functions","content":"Snapshot both training state (for resume) and sampler weights\n(for eval), then record one manifest row."},"2847":{"id":"/docs/evsys_sdk/training/loop/TrainingLoop-5","page_id":"/docs/evsys_sdk/training/loop/TrainingLoop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/TrainingLoop#functions","content":"Per-evaluator cadence check. `run_every \\<= 0` → disabled;\npositive → fire when `(step + 1) % run_every == 0`."},"2848":{"id":"/docs/evsys_sdk/training/loop/TrainingLoop-6","page_id":"/docs/evsys_sdk/training/loop/TrainingLoop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/TrainingLoop#functions","content":"Take ONE sampler snapshot for the step, run each due evaluator,\nlog results under `val/\\<eval_name>/\\<metric>`."},"2849":{"id":"/docs/evsys_sdk/training/loop/TrainingLoop-7","page_id":"/docs/evsys_sdk/training/loop/TrainingLoop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/TrainingLoop#functions","content":"Call `hook` on every callback (error-isolated). Thin wrapper over\nthe shared :func:`~evsys_sdk.training.callbacks.dispatch` so the loop\nand the Experiment fan out identically."},"2850":{"id":"/docs/evsys_sdk/training/loop/_LoopMetricKeys","page_id":"/docs/evsys_sdk/training/loop/_LoopMetricKeys","type":"page","content":"_LoopMetricKeys","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","loop"],"tags":[],"url":"/docs/evsys_sdk/training/loop/_LoopMetricKeys"},"2851":{"id":"/docs/evsys_sdk/training/loop/_LoopMetricKeys-0","page_id":"/docs/evsys_sdk/training/loop/_LoopMetricKeys","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/loop/_LoopMetricKeys#attributes","content":"Attributes"},"2852":{"id":"/docs/evsys_sdk/training/loop/_LoopMetricKeys-1","page_id":"/docs/evsys_sdk/training/loop/_LoopMetricKeys","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/loop/_LoopMetricKeys#functions","content":"Functions"},"2853":{"id":"/docs/evsys_sdk/training/loop/_LoopMetricKeys-2","page_id":"/docs/evsys_sdk/training/loop/_LoopMetricKeys","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop/_LoopMetricKeys","content":"Per-step metric keys the loop always emits (independent of algorithm)."},"2854":{"id":"/docs/evsys_sdk/training/loop","page_id":"/docs/evsys_sdk/training/loop","type":"page","content":"loop","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","loop"],"tags":[],"url":"/docs/evsys_sdk/training/loop"},"2855":{"id":"/docs/evsys_sdk/training/loop-0","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"TrainingLoop — algorithm-agnostic driver around a tinker\ntraining client."},"2856":{"id":"/docs/evsys_sdk/training/loop-1","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"The loop owns:"},"2857":{"id":"/docs/evsys_sdk/training/loop-2","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"the `for step in range(start, num_steps)` iteration,"},"2858":{"id":"/docs/evsys_sdk/training/loop-3","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"dispatching `forward_backward_async` then `optim_step_async`,"},"2859":{"id":"/docs/evsys_sdk/training/loop-4","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"routing a callable `loss_fn` through `forward_backward_custom_async`,"},"2860":{"id":"/docs/evsys_sdk/training/loop-5","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"periodic checkpoint saves via :class:`~evsys_sdk.training.checkpoints.CheckpointManager`,"},"2861":{"id":"/docs/evsys_sdk/training/loop-6","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"periodic in-loop evaluation via :class:`Evaluator` objects,"},"2862":{"id":"/docs/evsys_sdk/training/loop-7","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"writing one row per step into `ctx.log_store` (so the existing\n`forward_step_metrics` forwarder picks them up unchanged),"},"2863":{"id":"/docs/evsys_sdk/training/loop-8","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"a final \"final\" checkpoint at the end of training."},"2864":{"id":"/docs/evsys_sdk/training/loop-9","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"What the loop does NOT own: data shaping. A :class:`StepBuilder` decides\nwhat each batch contains and computes algorithm-specific metrics. That's\nthe seam SFT / SDFT / RL plug into."},"2865":{"id":"/docs/evsys_sdk/training/loop-10","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"Designed to be exercised against\n:class:`~evsys_sdk.training.backend.MockBackend` end-to-end so tests don't\nneed a real tinker session."},"2866":{"id":"/docs/evsys_sdk/training/loop-11","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"<Card title=\"&#x22;TrainingBatch&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/loop/TrainingBatch&#x22;\" />"},"2867":{"id":"/docs/evsys_sdk/training/loop-12","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"<Card title=\"&#x22;StepBuilder&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/loop/StepBuilder&#x22;\" />"},"2868":{"id":"/docs/evsys_sdk/training/loop-13","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"<Card title=\"&#x22;Evaluator&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/loop/Evaluator&#x22;\" />"},"2869":{"id":"/docs/evsys_sdk/training/loop-14","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"<Card title=\"&#x22;LoopArtifacts&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/loop/LoopArtifacts&#x22;\" />"},"2870":{"id":"/docs/evsys_sdk/training/loop-15","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"<Card title=\"&#x22;_LoopMetricKeys&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/loop/_LoopMetricKeys&#x22;\" />"},"2871":{"id":"/docs/evsys_sdk/training/loop-16","page_id":"/docs/evsys_sdk/training/loop","tags":[],"type":"text","url":"/docs/evsys_sdk/training/loop","content":"<Card title=\"&#x22;TrainingLoop&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/loop/TrainingLoop&#x22;\" />"},"2872":{"id":"/docs/evsys_sdk/training/harbor_eval","page_id":"/docs/evsys_sdk/training/harbor_eval","type":"page","content":"harbor_eval","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","harbor_eval"],"tags":[],"url":"/docs/evsys_sdk/training/harbor_eval"},"2873":{"id":"/docs/evsys_sdk/training/harbor_eval-0","page_id":"/docs/evsys_sdk/training/harbor_eval","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_eval","content":"Benchmark / validation evaluation through harbor's rollout engine."},"2874":{"id":"/docs/evsys_sdk/training/harbor_eval-1","page_id":"/docs/evsys_sdk/training/harbor_eval","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_eval","content":"Eval reuses the *same* engine as training: a benchmark is a set of\n:class:`~evsys_sdk.data_types.HarborTask`\\s (instruction + verifier), so\nscoring it is just :func:`~evsys_sdk.training.harbor_engine.run_harbor_rollouts`\nover those tasks — the verifier reward *is* the eval score."},"2875":{"id":"/docs/evsys_sdk/training/harbor_eval-2","page_id":"/docs/evsys_sdk/training/harbor_eval","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_eval","content":"Unlike training, eval rollouts are **uploaded to the dashboard** (Supabase)\nwith `kind='eval'` via :func:`upload_eval_rollouts`. (Training rollouts stay\non disk in the run workspace and are never uploaded.)"},"2876":{"id":"/docs/evsys_sdk/training/harbor_eval-3","page_id":"/docs/evsys_sdk/training/harbor_eval","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_eval","content":"The metrics / prediction builders are pure functions over\n:class:`TrajectoryGroup`\\s — harbor-free and directly testable."},"2877":{"id":"/docs/evsys_sdk/training/harbor_eval-4","page_id":"/docs/evsys_sdk/training/harbor_eval","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_eval","content":"Reduce per-task rollout rewards to the benchmark's declared metrics,\nplus per-task economics."},"2878":{"id":"/docs/evsys_sdk/training/harbor_eval-5","page_id":"/docs/evsys_sdk/training/harbor_eval","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_eval","content":"`metrics` is a list of registered metric names (e.g. `[\"pass@3\",\n\"pass^3\", \"avg\"]`); each is looked up via :func:`get_metric` and applied\nto the per-task sample rewards (one inner list per task, holding that task's\n`num_samples` rewards). `n_tasks` is always included; when no metrics\nare declared it defaults to `mean_reward` + `pass_rate`."},"2879":{"id":"/docs/evsys_sdk/training/harbor_eval-6","page_id":"/docs/evsys_sdk/training/harbor_eval","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_eval","content":"Independently, `\\{time_per_task, tokens_per_task, cost_per_task\\}` are added\nwhenever harbor reported the underlying usage (cost is omitted for runs with\nno API price, e.g. on-policy tinker)."},"2880":{"id":"/docs/evsys_sdk/training/harbor_eval-7","page_id":"/docs/evsys_sdk/training/harbor_eval","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_eval","content":"Per-task mean latency / token count / cost over the group's\ntrajectories, reading the `metadata['usage']` harbor\\_engine stamps on\neach rollout. A field is `None` when no trajectory reported it."},"2881":{"id":"/docs/evsys_sdk/training/harbor_eval-8","page_id":"/docs/evsys_sdk/training/harbor_eval","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_eval","content":"Build dashboard prediction rows (`kind='eval'`) — one per\n(task, sample). Carries the token-level rollout + reward for the eval."},"2882":{"id":"/docs/evsys_sdk/training/harbor_eval-9","page_id":"/docs/evsys_sdk/training/harbor_eval","tags":[],"type":"text","url":"/docs/evsys_sdk/training/harbor_eval","content":"Upload eval predictions to the dashboard. Accepts either a\n`DashboardClient` (`log_predictions`) or an `EvsysStore`\n(`add_prediction` per row). No-op when `store`/`run_id` is falsy."},"2883":{"id":"/docs/evsys_sdk/training/sdft_data/CompletionSlice","page_id":"/docs/evsys_sdk/training/sdft_data/CompletionSlice","type":"page","content":"CompletionSlice","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","sdft_data"],"tags":[],"url":"/docs/evsys_sdk/training/sdft_data/CompletionSlice"},"2884":{"id":"/docs/evsys_sdk/training/sdft_data/CompletionSlice-0","page_id":"/docs/evsys_sdk/training/sdft_data/CompletionSlice","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/sdft_data/CompletionSlice#attributes","content":"Attributes"},"2885":{"id":"/docs/evsys_sdk/training/sdft_data/CompletionSlice-1","page_id":"/docs/evsys_sdk/training/sdft_data/CompletionSlice","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/sdft_data/CompletionSlice#functions","content":"Functions"},"2886":{"id":"/docs/evsys_sdk/training/sdft_data/CompletionSlice-2","page_id":"/docs/evsys_sdk/training/sdft_data/CompletionSlice","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data/CompletionSlice#attributes","content":"The completion tokens themselves."},"2887":{"id":"/docs/evsys_sdk/training/sdft_data/CompletionSlice-3","page_id":"/docs/evsys_sdk/training/sdft_data/CompletionSlice","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data/CompletionSlice#attributes","content":"Length of the teacher prompt in tokens (used to pull the right slice\nfrom teacher logprob arrays)."},"2888":{"id":"/docs/evsys_sdk/training/sdft_data/SDFTDataset","page_id":"/docs/evsys_sdk/training/sdft_data/SDFTDataset","type":"page","content":"SDFTDataset","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","sdft_data"],"tags":[],"url":"/docs/evsys_sdk/training/sdft_data/SDFTDataset"},"2889":{"id":"/docs/evsys_sdk/training/sdft_data/SDFTDataset-0","page_id":"/docs/evsys_sdk/training/sdft_data/SDFTDataset","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/sdft_data/SDFTDataset#functions","content":"Functions"},"2890":{"id":"/docs/evsys_sdk/training/sdft_data/SDFTDataset-1","page_id":"/docs/evsys_sdk/training/sdft_data/SDFTDataset","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data/SDFTDataset","content":"The data interface the SDFT algorithm consumes per step."},"2891":{"id":"/docs/evsys_sdk/training/sdft_data/SDFTDataset-2","page_id":"/docs/evsys_sdk/training/sdft_data/SDFTDataset","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data/SDFTDataset","content":"Per the SDFT paper, each step needs `batch_size` `(question, golden_answer)`\npairs — the student rolls out on the question, the teacher scores\nteacher-forced through the question+golden\\_answer demo."},"2892":{"id":"/docs/evsys_sdk/training/sdft_data/SDFTDataset-3","page_id":"/docs/evsys_sdk/training/sdft_data/SDFTDataset","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data/SDFTDataset#functions","content":"Return `(questions, golden_answers)` of length `batch_size`."},"2893":{"id":"/docs/evsys_sdk/training/sdft_data/SimpleSDFTDataset","page_id":"/docs/evsys_sdk/training/sdft_data/SimpleSDFTDataset","type":"page","content":"SimpleSDFTDataset","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","sdft_data"],"tags":[],"url":"/docs/evsys_sdk/training/sdft_data/SimpleSDFTDataset"},"2894":{"id":"/docs/evsys_sdk/training/sdft_data/SimpleSDFTDataset-0","page_id":"/docs/evsys_sdk/training/sdft_data/SimpleSDFTDataset","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/sdft_data/SimpleSDFTDataset#attributes","content":"Attributes"},"2895":{"id":"/docs/evsys_sdk/training/sdft_data/SimpleSDFTDataset-1","page_id":"/docs/evsys_sdk/training/sdft_data/SimpleSDFTDataset","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/sdft_data/SimpleSDFTDataset#functions","content":"Functions"},"2896":{"id":"/docs/evsys_sdk/training/sdft_data/SimpleSDFTDataset-2","page_id":"/docs/evsys_sdk/training/sdft_data/SimpleSDFTDataset","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data/SimpleSDFTDataset","content":"Stock :class:`SDFTDataset` over :class:`~evsys_sdk.data_types.PromptExample`\nrows: the question lives in `inputs['question']` and the gold answer in\n`expected`. Wraps modulo dataset length so the loop can exceed one epoch\n(no `_RepeatingSDFTProvider` hack needed)."},"2897":{"id":"/docs/evsys_sdk/training/sdft_data","page_id":"/docs/evsys_sdk/training/sdft_data","type":"page","content":"sdft_data","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","sdft_data"],"tags":[],"url":"/docs/evsys_sdk/training/sdft_data"},"2898":{"id":"/docs/evsys_sdk/training/sdft_data-0","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"SDFT data shaping — port the cookbook's distillation math, minus\norchestration. Pure functions over tinker types — no I/O, no\n`tinker_cookbook` imports."},"2899":{"id":"/docs/evsys_sdk/training/sdft_data-1","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"The Self-Distillation Fine-Tuning algorithm (Shenfeld et al., 2026):"},"2900":{"id":"/docs/evsys_sdk/training/sdft_data-2","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"**Student rollout** — sample from the live student weights on the user\nquestion (no demo). Each sample is a completion + per-position logprobs."},"2901":{"id":"/docs/evsys_sdk/training/sdft_data-3","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"**Teacher prompt** — build a frozen-teacher prompt that contains the\ngolden answer as an in-context demonstration."},"2902":{"id":"/docs/evsys_sdk/training/sdft_data-4","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"**Teacher topK** — append the student completion to the teacher prompt,\nask the teacher for its top-K token distribution at each completion\nposition via tinker's `topk_prompt_logprobs` sampling API."},"2903":{"id":"/docs/evsys_sdk/training/sdft_data-5","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"**CE distillation** — train the student to match the teacher's\nrenormalized top-K distribution at each position via cross\\_entropy."},"2904":{"id":"/docs/evsys_sdk/training/sdft_data-6","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"This module owns Step 4's data shaping (turning teacher responses into\n`tinker.Datum` objects with `(N, K)`-shaped target\\_tokens + weights)\nplus the teacher-prompt helper for Step 2. The\n:class:`~evsys_sdk.algorithms.sdft.SDFT` algorithm orchestrates 1-4."},"2905":{"id":"/docs/evsys_sdk/training/sdft_data-7","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"The cookbook's default demonstration template. Researchers usually\noverride this in the algorithm config (e.g. to bracket the golden answer\nin `\\<answer>...\\</answer>` tags)."},"2906":{"id":"/docs/evsys_sdk/training/sdft_data-8","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"<Card title=\"&#x22;CompletionSlice&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/sdft_data/CompletionSlice&#x22;\" />"},"2907":{"id":"/docs/evsys_sdk/training/sdft_data-9","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"<Card title=\"&#x22;SDFTDataset&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/sdft_data/SDFTDataset&#x22;\" />"},"2908":{"id":"/docs/evsys_sdk/training/sdft_data-10","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"<Card title=\"&#x22;SimpleSDFTDataset&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/sdft_data/SimpleSDFTDataset&#x22;\" />"},"2909":{"id":"/docs/evsys_sdk/training/sdft_data-11","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"Render the teacher prompt (system + user-with-demo) → `ModelInput`."},"2910":{"id":"/docs/evsys_sdk/training/sdft_data-12","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"The teacher gets to see the golden answer as a soft hint in the user\nturn (via `demo_template`). Student completions then get appended to\nthis prompt for teacher-forced top-K scoring."},"2911":{"id":"/docs/evsys_sdk/training/sdft_data-13","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"We use :func:`~evsys_sdk.training.templates.messages_to_model_input`\nrather than the cookbook's `Renderer.build_generation_prompt` —\nsame end shape (HF chat-template applied with add\\_generation\\_prompt=True),\nno Renderer class hierarchy needed."},"2912":{"id":"/docs/evsys_sdk/training/sdft_data-14","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"Wrap a student rollout (prompt + sampled completion) as a `tinker.Datum`."},"2913":{"id":"/docs/evsys_sdk/training/sdft_data-15","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"The Datum is what :func:`build_topk_targets` consumes: it carries the\nfull sequence as `model_input` and a per-position mask indicating\nwhich positions are completion tokens (the ones the teacher scores)."},"2914":{"id":"/docs/evsys_sdk/training/sdft_data-16","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"Position alignment (matches the cookbook convention):"},"2915":{"id":"/docs/evsys_sdk/training/sdft_data-17","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"`model_input` covers `prompt + completion[:-1]` (left-shifted)"},"2916":{"id":"/docs/evsys_sdk/training/sdft_data-18","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"`target_tokens` covers `completion` (the loss targets)"},"2917":{"id":"/docs/evsys_sdk/training/sdft_data-19","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"`mask` is `1` on completion positions and `0` on prompt positions"},"2918":{"id":"/docs/evsys_sdk/training/sdft_data-20","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"Pull the completion tokens off a student `Datum`, truncating if\n`teacher_prompt + completion` would exceed `max_context_length`."},"2919":{"id":"/docs/evsys_sdk/training/sdft_data-21","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"The cookbook does the same step inline; here it's a named function so\nthe :class:`~evsys_sdk.algorithms.sdft.SDFT` algorithm and tests\nshare the implementation."},"2920":{"id":"/docs/evsys_sdk/training/sdft_data-22","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"Append completion tokens to a teacher prompt to form the sequence\nthe teacher will score."},"2921":{"id":"/docs/evsys_sdk/training/sdft_data-23","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"Build cross\\_entropy Datums with `(N, K)` soft targets from a\nbatch of teacher top-K responses. Pure function — no I/O."},"2922":{"id":"/docs/evsys_sdk/training/sdft_data-24","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"Student Datums from :func:`student_datum_from_rollout`. Their\n`mask` tells us which positions are completion tokens; the\nloss targets the K-best teacher tokens at each of those positions."},"2923":{"id":"/docs/evsys_sdk/training/sdft_data-25","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"Output of :func:`extract_completion_tokens` (one per datum). Carries\nthe teacher\\_prompt\\_len needed to index into `teacher_topk_logprobs`."},"2924":{"id":"/docs/evsys_sdk/training/sdft_data-26","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"One list per datum. Each is a per-position list (length =\nteacher\\_prompt + completion length); each position is either\n`None` or a list of `(token_id, logprob)` tuples (the teacher's\ntop-K). On real tinker this comes from\n`sample_async(topk_prompt_logprobs=K).topk_prompt_logprobs`."},"2925":{"id":"/docs/evsys_sdk/training/sdft_data-27","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"How many of the teacher's top tokens to keep (truncates if the\nteacher returned fewer)."},"2926":{"id":"/docs/evsys_sdk/training/sdft_data-28","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"If set, drop teacher tokens >= `vocab_size` (handles special\ntokens vLLM may emit outside the student's vocab)."},"2927":{"id":"/docs/evsys_sdk/training/sdft_data-29","page_id":"/docs/evsys_sdk/training/sdft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sdft_data","content":"Skip the first N completion positions from the loss. Matches the\nreference SDFT paper (default 3)."},"2928":{"id":"/docs/evsys_sdk/training/sft_data","page_id":"/docs/evsys_sdk/training/sft_data","type":"page","content":"sft_data","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","sft_data"],"tags":[],"url":"/docs/evsys_sdk/training/sft_data"},"2929":{"id":"/docs/evsys_sdk/training/sft_data-0","page_id":"/docs/evsys_sdk/training/sft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sft_data","content":"SFT data shaping — turn `\\{messages: [...]\\}` rows into `tinker.Datum`s."},"2930":{"id":"/docs/evsys_sdk/training/sft_data-1","page_id":"/docs/evsys_sdk/training/sft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sft_data","content":"Pure function over the tokenizer + max\\_seq\\_len + enable\\_thinking; no\ntinker\\_cookbook imports, no global state. The `SFT` algorithm calls\n`sft_tokenize` once at construction time and reads tokenized Datums out of\nthe result in each `build_batch` call."},"2931":{"id":"/docs/evsys_sdk/training/sft_data-2","page_id":"/docs/evsys_sdk/training/sft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sft_data","content":"Output shape: `list[tinker.Datum]` where each `Datum` has"},"2932":{"id":"/docs/evsys_sdk/training/sft_data-3","page_id":"/docs/evsys_sdk/training/sft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sft_data","content":"`model_input`       — token ids of the *entire* chat-templated sequence"},"2933":{"id":"/docs/evsys_sdk/training/sft_data-4","page_id":"/docs/evsys_sdk/training/sft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sft_data","content":"`loss_fn_inputs[\"weights\"]` — per-position float mask, `1.0` on\nassistant tokens, `0.0` elsewhere."},"2934":{"id":"/docs/evsys_sdk/training/sft_data-5","page_id":"/docs/evsys_sdk/training/sft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sft_data","content":"This is the shape tinker's server-side `cross_entropy` loss consumes;\nsee `training_client.forward_backward_async(loss_fn=\"cross_entropy\")`."},"2935":{"id":"/docs/evsys_sdk/training/sft_data-6","page_id":"/docs/evsys_sdk/training/sft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sft_data","content":"Which assistant turns the loss is computed on. This is an *algorithm*\ndecision (passed in by the composer), NOT a property of the dataset —\n:class:`~evsys_sdk.data_types.ChatMessagesRow` carries only the conversation."},"2936":{"id":"/docs/evsys_sdk/training/sft_data-7","page_id":"/docs/evsys_sdk/training/sft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sft_data","content":"Tokenize every :class:`ChatMessagesRow` → list of `tinker.Datum`."},"2937":{"id":"/docs/evsys_sdk/training/sft_data-8","page_id":"/docs/evsys_sdk/training/sft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sft_data","content":"`supervise` selects which assistant turns are loss-masked\n(`all_assistant` = every assistant turn, `last_assistant` = only the\nfinal one). Rows that render zero supervised tokens (e.g. system+user only,\nor no assistant turn) are silently dropped; a warning logs the count."},"2938":{"id":"/docs/evsys_sdk/training/sft_data-9","page_id":"/docs/evsys_sdk/training/sft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sft_data","content":"Single-row tokenize + assistant-span loss mask → `tinker.Datum`."},"2939":{"id":"/docs/evsys_sdk/training/sft_data-10","page_id":"/docs/evsys_sdk/training/sft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sft_data","content":"Strategy: render the full sequence once for the input ids; then walk\nthe messages and for each *supervised* assistant turn, render up to (and\nnot including) it with `add_generation_prompt=True` to find the prefix\nspan, render through it without to find the end. The diff is the\nassistant token span — mark it 1.0 in the weight vector. `supervise`\nselects which assistant turns count (all, or just the last)."},"2940":{"id":"/docs/evsys_sdk/training/sft_data-11","page_id":"/docs/evsys_sdk/training/sft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sft_data","content":"Returns `None` when the row has no assistant turn or the supervised\nspan ends up empty after truncation to `max_seq_len`."},"2941":{"id":"/docs/evsys_sdk/training/sft_data-12","page_id":"/docs/evsys_sdk/training/sft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sft_data","content":"Construct the `Datum` the cross\\_entropy loss expects."},"2942":{"id":"/docs/evsys_sdk/training/sft_data-13","page_id":"/docs/evsys_sdk/training/sft_data","tags":[],"type":"text","url":"/docs/evsys_sdk/training/sft_data","content":"Tinker's CE loss is left-shifted (predicts position `t` from position\n`t-1`), so `model_input` covers positions `[0, N-1]`, `target_tokens`\ncovers `[1, N]`, and `weights` aligns with `target_tokens`."},"2943":{"id":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend","page_id":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend","type":"page","content":"TinkerBackend","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","tinker_backend"],"tags":[],"url":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend"},"2944":{"id":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend-0","page_id":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend#functions","content":"Functions"},"2945":{"id":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend-1","page_id":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend","content":"Implements :class:`~evsys_sdk.training.backend.Backend` over tinker."},"2946":{"id":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend-2","page_id":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend","content":"Construct via the :meth:`create` async factory. Sync method calls\n(`forward_backward_async`, `optim_step_async`,\n`forward_backward_custom_async`) return the underlying tinker\n`APIFuture` directly so the loop's existing `.result_async()`\nawaits work unchanged."},"2947":{"id":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend-3","page_id":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend#functions","content":"Async factory."},"2948":{"id":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend-4","page_id":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend#functions","content":"`resume_state_path`: when provided, the training client is created\nfrom that prior `state_path` *with* optimizer state (full resume).\n`init_weights_path`: load *weights only* from that prior state path\nand start a fresh optimizer (used to chain continual-learning stages).\nWhen both are `None`, a fresh LoRA training client is allocated at\n`model_name` with `lora_rank`. `resume_state_path` wins if both\nare set."},"2949":{"id":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend-5","page_id":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend/TinkerBackend#functions","content":"`renderer_name` is recorded onto the underlying training client's\nuser metadata so the inference path can read it back from a\ncheckpoint manifest (same convention tinker\\_cookbook used)."},"2950":{"id":"/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient","page_id":"/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient","type":"page","content":"TinkerSamplingClient","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","tinker_backend"],"tags":[],"url":"/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient"},"2951":{"id":"/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient-0","page_id":"/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient#attributes","content":"Attributes"},"2952":{"id":"/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient-1","page_id":"/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient#functions","content":"Functions"},"2953":{"id":"/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient-2","page_id":"/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient","content":"Wrap a `tinker.SamplingClient` to satisfy the\n:class:`~evsys_sdk.training.backend.SamplingClient` Protocol shape."},"2954":{"id":"/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient-3","page_id":"/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient","content":"Same name + same async method signatures as the Protocol, plus a\n`raw` attribute for callers that want the underlying tinker client."},"2955":{"id":"/docs/evsys_sdk/training/tinker_backend/_CoroFuture","page_id":"/docs/evsys_sdk/training/tinker_backend/_CoroFuture","type":"page","content":"_CoroFuture","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","tinker_backend"],"tags":[],"url":"/docs/evsys_sdk/training/tinker_backend/_CoroFuture"},"2956":{"id":"/docs/evsys_sdk/training/tinker_backend/_CoroFuture-0","page_id":"/docs/evsys_sdk/training/tinker_backend/_CoroFuture","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/tinker_backend/_CoroFuture#attributes","content":"Attributes"},"2957":{"id":"/docs/evsys_sdk/training/tinker_backend/_CoroFuture-1","page_id":"/docs/evsys_sdk/training/tinker_backend/_CoroFuture","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/tinker_backend/_CoroFuture#functions","content":"Functions"},"2958":{"id":"/docs/evsys_sdk/training/tinker_backend/_CoroFuture-2","page_id":"/docs/evsys_sdk/training/tinker_backend/_CoroFuture","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend/_CoroFuture","content":"Bridge tinker's coroutine-returning `*_async` methods to the\n:class:`~evsys_sdk.training.loop.TrainingLoop` contract."},"2959":{"id":"/docs/evsys_sdk/training/tinker_backend/_CoroFuture-3","page_id":"/docs/evsys_sdk/training/tinker_backend/_CoroFuture","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend/_CoroFuture","content":"The loop fires forward\\_backward / optim WITHOUT awaiting, then awaits each\none's `result_async()` (the shape :class:`MockBackend` implements). But\ntinker's `forward_backward_async` / `optim_step_async` are *coroutine\nfunctions* — calling them returns an un-awaited coroutine, not a future.\nThis wraps that coroutine so `await wrapper.result_async()` awaits the\ncoroutine to obtain the tinker future, then awaits the future's result."},"2960":{"id":"/docs/evsys_sdk/training/tinker_backend","page_id":"/docs/evsys_sdk/training/tinker_backend","type":"page","content":"tinker_backend","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","tinker_backend"],"tags":[],"url":"/docs/evsys_sdk/training/tinker_backend"},"2961":{"id":"/docs/evsys_sdk/training/tinker_backend-0","page_id":"/docs/evsys_sdk/training/tinker_backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend","content":"TinkerBackend — concrete :class:`~evsys_sdk.training.backend.Backend`\nimplementation against `tinker.ServiceClient`."},"2962":{"id":"/docs/evsys_sdk/training/tinker_backend-1","page_id":"/docs/evsys_sdk/training/tinker_backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend","content":"Constructed via `await TinkerBackend.create(model_name=..., lora_rank=...)`\n— the underlying `create_lora_training_client_async` is async, so the\nfactory is async. Algorithm composers run the loop inside one\n`asyncio.run(...)` call so the constructor and the loop body share the\nsame event loop:"},"2963":{"id":"/docs/evsys_sdk/training/tinker_backend-2","page_id":"/docs/evsys_sdk/training/tinker_backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend","content":"async def \\_train(self, ctx):\nbackend = await TinkerBackend.create(...)\nloop = TrainingLoop(backend=backend, ...)\nreturn await loop.run(num\\_steps=cfg.max\\_steps)"},"2964":{"id":"/docs/evsys_sdk/training/tinker_backend-3","page_id":"/docs/evsys_sdk/training/tinker_backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend","content":"def train(self, ctx):\nreturn asyncio.run(self.\\_train(ctx))"},"2965":{"id":"/docs/evsys_sdk/training/tinker_backend-4","page_id":"/docs/evsys_sdk/training/tinker_backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend","content":"The wrapper is thin — every method is a one-to-one passthrough to the\nunderlying tinker client, plus the one ergonomic affordance of returning\na wrapped :class:`TinkerSamplingClient` from\n`snapshot_sampling_client` (so callers don't have to know about the\nsampler URI machinery)."},"2966":{"id":"/docs/evsys_sdk/training/tinker_backend-5","page_id":"/docs/evsys_sdk/training/tinker_backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend","content":"<Card title=\"&#x22;_CoroFuture&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/tinker_backend/_CoroFuture&#x22;\" />"},"2967":{"id":"/docs/evsys_sdk/training/tinker_backend-6","page_id":"/docs/evsys_sdk/training/tinker_backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend","content":"<Card title=\"&#x22;TinkerSamplingClient&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/tinker_backend/TinkerSamplingClient&#x22;\" />"},"2968":{"id":"/docs/evsys_sdk/training/tinker_backend-7","page_id":"/docs/evsys_sdk/training/tinker_backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend","content":"<Card title=\"&#x22;TinkerBackend&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/tinker_backend/TinkerBackend&#x22;\" />"},"2969":{"id":"/docs/evsys_sdk/training/tinker_backend-8","page_id":"/docs/evsys_sdk/training/tinker_backend","tags":[],"type":"text","url":"/docs/evsys_sdk/training/tinker_backend","content":"Tinker's save\\_\\*\\_async result envelopes carry a `.path` attribute\n(verified against cookbook usage in distillation/sdft.py:739, where the\nsame dotted access ships)."},"2970":{"id":"/docs/evsys_sdk/training/templates","page_id":"/docs/evsys_sdk/training/templates","type":"page","content":"templates","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","templates"],"tags":[],"url":"/docs/evsys_sdk/training/templates"},"2971":{"id":"/docs/evsys_sdk/training/templates-0","page_id":"/docs/evsys_sdk/training/templates","tags":[],"type":"text","url":"/docs/evsys_sdk/training/templates","content":"Chat-template helpers — thin wrappers over `tokenizer.apply_chat_template`."},"2972":{"id":"/docs/evsys_sdk/training/templates-1","page_id":"/docs/evsys_sdk/training/templates","tags":[],"type":"text","url":"/docs/evsys_sdk/training/templates","content":"We deliberately do NOT reproduce tinker\\_cookbook's `Renderer` class hierarchy\n— Hugging Face's tokenizers already implement the template via\n`apply_chat_template`, and the cookbook's `Renderer` subclasses just wrap\nthat call with per-model defaults (`enable_thinking=False` for Qwen3.5-disable\nvariants, etc.). We forward the kwarg directly when set, which keeps every\nHF chat-template-aware tokenizer working uniformly."},"2973":{"id":"/docs/evsys_sdk/training/templates-2","page_id":"/docs/evsys_sdk/training/templates","tags":[],"type":"text","url":"/docs/evsys_sdk/training/templates","content":"The functions here return `tinker.ModelInput` so they're drop-in for any\nsampling / forward call."},"2974":{"id":"/docs/evsys_sdk/training/templates-3","page_id":"/docs/evsys_sdk/training/templates","tags":[],"type":"text","url":"/docs/evsys_sdk/training/templates","content":"Role-tagged chat message — `\\{\"role\": \"system\" | \"user\" | \"assistant\", \"content\": \"...\"\\}`.\nMatches the HF `apply_chat_template` input shape."},"2975":{"id":"/docs/evsys_sdk/training/templates-4","page_id":"/docs/evsys_sdk/training/templates","tags":[],"type":"text","url":"/docs/evsys_sdk/training/templates","content":"Call `apply_chat_template` with `enable_thinking` forwarded only\nwhen explicitly set."},"2976":{"id":"/docs/evsys_sdk/training/templates-5","page_id":"/docs/evsys_sdk/training/templates","tags":[],"type":"text","url":"/docs/evsys_sdk/training/templates","content":"Why the gate: Qwen3.5 tokenizers accept `enable_thinking`, but most\nothers do NOT and raise on the unknown kwarg. Forwarding only when set\nkeeps the helper tokenizer-agnostic — same approach already in\n`ChatTemplatedInference` (`inference/chat_templated.py`)."},"2977":{"id":"/docs/evsys_sdk/training/templates-6","page_id":"/docs/evsys_sdk/training/templates","tags":[],"type":"text","url":"/docs/evsys_sdk/training/templates","content":"Apply chat template → encode → build `tinker.ModelInput`."},"2978":{"id":"/docs/evsys_sdk/training/templates-7","page_id":"/docs/evsys_sdk/training/templates","tags":[],"type":"text","url":"/docs/evsys_sdk/training/templates","content":"Use `add_generation_prompt=True` for sampling prompts (the assistant\nturn isn't included yet; the model writes it). `False` when building\na completed sequence (e.g. SFT teacher-forcing)."},"2979":{"id":"/docs/evsys_sdk/training/templates-8","page_id":"/docs/evsys_sdk/training/templates","tags":[],"type":"text","url":"/docs/evsys_sdk/training/templates","content":"Bypass chat-templating; tokenize `text` verbatim. For callers that\nalready have a fully rendered prompt string."},"2980":{"id":"/docs/evsys_sdk/training/trajectory/Trajectory","page_id":"/docs/evsys_sdk/training/trajectory/Trajectory","type":"page","content":"Trajectory","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","trajectory"],"tags":[],"url":"/docs/evsys_sdk/training/trajectory/Trajectory"},"2981":{"id":"/docs/evsys_sdk/training/trajectory/Trajectory-0","page_id":"/docs/evsys_sdk/training/trajectory/Trajectory","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/trajectory/Trajectory#attributes","content":"Attributes"},"2982":{"id":"/docs/evsys_sdk/training/trajectory/Trajectory-1","page_id":"/docs/evsys_sdk/training/trajectory/Trajectory","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/trajectory/Trajectory#functions","content":"Functions"},"2983":{"id":"/docs/evsys_sdk/training/trajectory/Trajectory-2","page_id":"/docs/evsys_sdk/training/trajectory/Trajectory","tags":[],"type":"text","url":"/docs/evsys_sdk/training/trajectory/Trajectory","content":"One rollout: an ordered list of :class:`Turn`\\s + a scalar reward."},"2984":{"id":"/docs/evsys_sdk/training/trajectory/Trajectory-3","page_id":"/docs/evsys_sdk/training/trajectory/Trajectory","tags":[],"type":"text","url":"/docs/evsys_sdk/training/trajectory/Trajectory#attributes","content":"Free-form per-rollout extras. The harbor harvest stamps a `\"usage\"`\ndict here — `\\{cost_usd, prompt_tokens, completion_tokens, cached_tokens,\nlatency_s\\}` (any field harbor didn't report is `None`) — which the eval\naggregator turns into the default `time_per_task` / `tokens_per_task` /\n`cost_per_task` metrics."},"2985":{"id":"/docs/evsys_sdk/training/trajectory/TrajectoryGroup","page_id":"/docs/evsys_sdk/training/trajectory/TrajectoryGroup","type":"page","content":"TrajectoryGroup","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","trajectory"],"tags":[],"url":"/docs/evsys_sdk/training/trajectory/TrajectoryGroup"},"2986":{"id":"/docs/evsys_sdk/training/trajectory/TrajectoryGroup-0","page_id":"/docs/evsys_sdk/training/trajectory/TrajectoryGroup","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/trajectory/TrajectoryGroup#attributes","content":"Attributes"},"2987":{"id":"/docs/evsys_sdk/training/trajectory/TrajectoryGroup-1","page_id":"/docs/evsys_sdk/training/trajectory/TrajectoryGroup","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/trajectory/TrajectoryGroup#functions","content":"Functions"},"2988":{"id":"/docs/evsys_sdk/training/trajectory/TrajectoryGroup-2","page_id":"/docs/evsys_sdk/training/trajectory/TrajectoryGroup","tags":[],"type":"text","url":"/docs/evsys_sdk/training/trajectory/TrajectoryGroup","content":"All rollouts sampled from one task (`num_samples` of them). The\ngroup-relative advantage baseline subtracts the within-group mean reward."},"2989":{"id":"/docs/evsys_sdk/training/trajectory/Turn","page_id":"/docs/evsys_sdk/training/trajectory/Turn","type":"page","content":"Turn","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","trajectory"],"tags":[],"url":"/docs/evsys_sdk/training/trajectory/Turn"},"2990":{"id":"/docs/evsys_sdk/training/trajectory/Turn-0","page_id":"/docs/evsys_sdk/training/trajectory/Turn","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/trajectory/Turn#attributes","content":"Attributes"},"2991":{"id":"/docs/evsys_sdk/training/trajectory/Turn-1","page_id":"/docs/evsys_sdk/training/trajectory/Turn","type":"heading","tags":[],"url":"/docs/evsys_sdk/training/trajectory/Turn#functions","content":"Functions"},"2992":{"id":"/docs/evsys_sdk/training/trajectory/Turn-2","page_id":"/docs/evsys_sdk/training/trajectory/Turn","tags":[],"type":"text","url":"/docs/evsys_sdk/training/trajectory/Turn","content":"One assistant turn of a rollout."},"2993":{"id":"/docs/evsys_sdk/training/trajectory/Turn-3","page_id":"/docs/evsys_sdk/training/trajectory/Turn","tags":[],"type":"text","url":"/docs/evsys_sdk/training/trajectory/Turn","content":"`prompt_tokens` is the full rendered context the policy saw for this turn\n(system + prior turns + the latest observation); `completion_tokens` /\n`logprobs` are the sampled response. A single-turn rollout has exactly one."},"2994":{"id":"/docs/evsys_sdk/training/trajectory/Turn-4","page_id":"/docs/evsys_sdk/training/trajectory/Turn","tags":[],"type":"text","url":"/docs/evsys_sdk/training/trajectory/Turn","content":"`logprobs` is optional — on-policy tinker rollouts populate it (training\nneeds it), but eval / closed-API rollouts often have none. Defaults to empty."},"2995":{"id":"/docs/evsys_sdk/training/trajectory","page_id":"/docs/evsys_sdk/training/trajectory","type":"page","content":"trajectory","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","training","trajectory"],"tags":[],"url":"/docs/evsys_sdk/training/trajectory"},"2996":{"id":"/docs/evsys_sdk/training/trajectory-0","page_id":"/docs/evsys_sdk/training/trajectory","tags":[],"type":"text","url":"/docs/evsys_sdk/training/trajectory","content":"The rollout data model — one shape for all (multi-turn) rollouts."},"2997":{"id":"/docs/evsys_sdk/training/trajectory-1","page_id":"/docs/evsys_sdk/training/trajectory","tags":[],"type":"text","url":"/docs/evsys_sdk/training/trajectory","content":"Every rollout in the SDK — single- or multi-turn, RL or SDFT — is a\n:class:`Trajectory`: an ordered list of :class:`Turn`\\s (each a prompt + a\nsampled completion with per-token logprobs) plus a scalar reward. Harbor's\n`RolloutDetail` (ATIF) is converted into this at the engine boundary\n(:func:`evsys_sdk.training.harbor_engine.run_harbor_rollouts`), so the rest of\nthe SDK only ever sees `Trajectory`. The IS-loss data prep\n(:mod:`evsys_sdk.training.data_processing`) emits one `Datum` per turn."},"2998":{"id":"/docs/evsys_sdk/training/trajectory-2","page_id":"/docs/evsys_sdk/training/trajectory","tags":[],"type":"text","url":"/docs/evsys_sdk/training/trajectory","content":"<Card title=\"&#x22;Turn&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/trajectory/Turn&#x22;\" />"},"2999":{"id":"/docs/evsys_sdk/training/trajectory-3","page_id":"/docs/evsys_sdk/training/trajectory","tags":[],"type":"text","url":"/docs/evsys_sdk/training/trajectory","content":"<Card title=\"&#x22;Trajectory&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/trajectory/Trajectory&#x22;\" />"},"3000":{"id":"/docs/evsys_sdk/training/trajectory-4","page_id":"/docs/evsys_sdk/training/trajectory","tags":[],"type":"text","url":"/docs/evsys_sdk/training/trajectory","content":"<Card title=\"&#x22;TrajectoryGroup&#x22;\" href=\"&#x22;/docs/evsys_sdk/training/trajectory/TrajectoryGroup&#x22;\" />"},"3001":{"id":"/docs/evsys_sdk/inference/tinker/TinkerInference","page_id":"/docs/evsys_sdk/inference/tinker/TinkerInference","type":"page","content":"TinkerInference","breadcrumbs":["Documentation","Reference","Api","evsys_sdk","inference","tinker"],"tags":[],"url":"/docs/evsys_sdk/inference/tinker/TinkerInference"},"3002":{"id":"/docs/evsys_sdk/inference/tinker/TinkerInference-0","page_id":"/docs/evsys_sdk/inference/tinker/TinkerInference","type":"heading","tags":[],"url":"/docs/evsys_sdk/inference/tinker/TinkerInference#attributes","content":"Attributes"},"3003":{"id":"/docs/evsys_sdk/inference/tinker/TinkerInference-1","page_id":"/docs/evsys_sdk/inference/tinker/TinkerInference","type":"heading","tags":[],"url":"/docs/evsys_sdk/inference/tinker/TinkerInference#functions","content":"Functions"},"3004":{"id":"/docs/evsys_sdk/inference/tinker/TinkerInference-2","page_id":"/docs/evsys_sdk/inference/tinker/TinkerInference","tags":[],"type":"text","url":"/docs/evsys_sdk/inference/tinker/TinkerInference#functions","content":"Submit all prompts concurrently, then collect results in order."},"3005":{"id":"/docs/evsys_sdk/inference/tinker/TinkerInference-3","page_id":"/docs/evsys_sdk/inference/tinker/TinkerInference","tags":[],"type":"text","url